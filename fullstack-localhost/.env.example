# =============================================================================================
# fullstack-localhost/.env.example
# =============================================================================================
#
# YOU PROBABLY DO NOT NEED THIS FILE.
# The stack runs with no .env at all: `pnpm stack:dev` or `pnpm stack:prod` in frontend/.
# Everything works except "Sign in with Google", which needs this file, and Stripe Checkout, which
# is off by default (see step 3). Create a .env only to turn either feature on
# or to change one of the other settings further down.
#
# HOW TO USE IT
#   1. Copy this file, keeping it in THIS folder:  cp fullstack-localhost/.env.example fullstack-localhost/.env
#   2. Edit fullstack-localhost/.env (NOT this .env.example file).
#   3. Restart the stack so the backend picks the values up: stop it, then run pnpm stack:dev or
#      pnpm stack:prod again. (`docker compose restart` is not enough; the container must be recreated,
#      which the pnpm scripts do for you.)
#
# RULES
#   - .env is gitignored. Never commit it, never paste it into chat, issues or PRs.
#   - No quotes, no spaces around "=":  GOOGLE_CLIENT_ID=abc   (not  GOOGLE_CLIENT_ID = "abc")
#   - A line starting with # is ignored. Leave a setting commented out to keep its default.
#   - Only local and test values belong here. Never use keys from the dev or production AWS
#     environments.
#
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# 1. Sign in with Google  (optional; without it the Google button fails with an error)
# ---------------------------------------------------------------------------------------------
# Ask the team for the Google OAuth client ID and secret of the localhost OAuth client, and paste
# them after the "=". That client must list this exact "Authorized redirect URI" in Google Cloud
# Console (APIs & Services > Credentials):
#     http://localhost:8080/api/v1/auth/oauth2/google/callback
# Always open the app at http://localhost:8080, in both stack:dev and stack:prod. Sign-in does NOT
# work at http://localhost:5173 or http://localhost:8589, because Google only returns to :8080.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Do not change this unless you also changed the port in compose.yaml and in Google Cloud Console.
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/google/callback


# ---------------------------------------------------------------------------------------------
# 2. Background jobs  (optional)
# ---------------------------------------------------------------------------------------------
# true starts the team-expiry sweep: every minute, blocs past their deadline are closed.
# Leave it false unless you are testing expiry.
# BLOCBUY_SCHEDULING_ENABLED=false


# ---------------------------------------------------------------------------------------------
# 3. Stripe Sandbox Checkout  (optional; leave off without a separate local test endpoint)
# ---------------------------------------------------------------------------------------------
# Use only your own Stripe test-mode values. The webhook must target
# http://localhost:8080/api/v1/webhooks/stripe (for example through Stripe CLI forwarding).
# Never use live keys or copy the dev host's signing secret. Recreate the backend container after
# changing the flag; the checkout return URLs already point to /payments/return on port 8080.
# BLOCBUY_STRIPE_CHECKOUT_ENABLED=false
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# BLOCBUY_PAYMENT_CHECKOUT_SUCCESS_URL=http://localhost:8080/payments/return
# BLOCBUY_PAYMENT_CHECKOUT_CANCEL_URL=http://localhost:8080/payments/return


# ---------------------------------------------------------------------------------------------
# 4. Database and Redis passwords  (optional; the defaults are fine)
# ---------------------------------------------------------------------------------------------
# These containers are reachable only from inside the stack, never from your network, so the
# defaults are safe on a laptop.
# WARNING: PostgreSQL stores the username and password when its data volume is first created.
# Changing them later breaks the backend's login until you delete the data, which also deletes
# everything in the local database:
#     docker compose -f fullstack-localhost/compose.yaml --profile dev down -v
# DB_USERNAME=blocbuy
# DB_PASSWORD=localhost-only
# REDIS_PASSWORD=localhost-only


# ---------------------------------------------------------------------------------------------
# Not configurable here, on purpose
# ---------------------------------------------------------------------------------------------
# FRONTEND_URL  Leave it unset. After sign-in the backend redirects to the relative path
#               /auth/callback, so you stay on http://localhost:8080 (as on CloudFront).
# Stripe        Checkout defaults off. The flag in step 3 enables it without changing the profile.
