# BlocBuy backend image for CI. Context: backend/.
# Runtime-only: expects the boot jar already built by the ci-backend build-quality
# job (mvn verify) and downloaded into blocbuy-bootstrap/target/ before docker build.
# Local builds use Dockerfile with the same prebuilt JAR (backend/docker-compose.yaml).

# Explicit OS line and multi-architecture digest; keep in sync with Dockerfile.
FROM eclipse-temurin:21-jre-noble@sha256:0c324fbe2e1455c3159184717440f3b52906ef82a39c4a6efc9edb401d31971a

# Temporary CVE-2026-84782 repair until a verified upstream rebuild includes it.
# Dependabot updates the base digest, not this package version; see the CI runbook.
ARG OPENSSL_FIXED_VERSION=3.0.13-0ubuntu3.16
WORKDIR /app

# Keep the conditional repair, post-checks and runtime user in sync with Dockerfile.
RUN set -eux; \
    set --; \
    for package in libssl3t64 openssl; do \
        test "$(dpkg-query -W -f='${db:Status-Status}' "$package")" = installed; \
        installed="$(dpkg-query -W -f='${Version}' "$package")"; \
        if dpkg --compare-versions "$installed" lt "$OPENSSL_FIXED_VERSION"; then \
            set -- "$@" "$package=$OPENSSL_FIXED_VERSION"; \
        fi; \
    done; \
    if [ "$#" -gt 0 ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends --only-upgrade "$@"; \
    fi; \
    for package in libssl3t64 openssl; do \
        installed="$(dpkg-query -W -f='${Version}' "$package")"; \
        dpkg --compare-versions "$installed" ge "$OPENSSL_FIXED_VERSION"; \
    done; \
    rm -rf /var/lib/apt/lists/*; \
    rm -f /usr/bin/pebble; \
    groupadd --system blocbuy; \
    useradd --system --gid blocbuy blocbuy
USER blocbuy

# finalName is blocbuy-backend (blocbuy-bootstrap/pom.xml) — the same jar the
# backend-application artifact carries and Dockerfile copies.
COPY blocbuy-bootstrap/target/blocbuy-backend.jar app.jar

EXPOSE 8589
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"

# Health probes are orchestrator-owned and target GET /api/actuator/health on :8589.
ENTRYPOINT ["java", "-jar", "app.jar"]
