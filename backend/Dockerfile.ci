# BlocBuy backend image for CI. Context: backend/.
# Runtime-only: expects the boot jar already built by the ci-backend build-quality
# job (mvn verify) and downloaded into blocbuy-bootstrap/target/ before docker build.
# Local builds use Dockerfile with the same prebuilt JAR (backend/docker-compose.yaml).

# Explicit OS line and multi-architecture digest; keep in sync with Dockerfile.
FROM eclipse-temurin:21-jre-noble@sha256:0eda5830ed7b669abc246a8dc520ea8a23cab06f9a8d4b6964109e2f2394e46f
WORKDIR /app

# Temporary CVE-2026-109518 / CVE-2026-111497 repair; keep in sync with Dockerfile.
# Use HTTPS and disable retries while upgrading the vulnerable APT client.
# Remove when the pinned upstream image meets all three minimum versions.
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get -o Acquire::Retries=0 update \
 && apt-get -o Acquire::Retries=0 install -y --no-install-recommends --only-upgrade \
      apt libapt-pkg6.0t64 libbrotli1 \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' apt)" ge '2.8.4ubuntu0.1' \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libapt-pkg6.0t64)" ge '2.8.4ubuntu0.1' \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge '1.1.0-2ubuntu0.1' \
 && rm -rf /var/lib/apt/lists/*

# Keep the runtime user and unused pebble removal in sync with Dockerfile.
RUN rm -f /usr/bin/pebble \
 && groupadd --system blocbuy \
 && useradd --system --gid blocbuy blocbuy
USER blocbuy

# The exec-classifier boot jar (blocbuy-bootstrap/pom.xml) — the same jar the
# backend-application artifact carries and Dockerfile copies. The plain
# blocbuy-backend.jar is a library and is kept out of the context (.dockerignore).
# SWE5001 service images pass JAR=services/<service>/target/<service>.jar (#456, C1);
# every other caller keeps the default and gets the monolith image.
ARG JAR=blocbuy-bootstrap/target/blocbuy-backend-exec.jar
COPY ${JAR} app.jar

# The root filesystem is read-only in both deployments; Tomcat and the JVM write only to
# /tmp. Compose mounts a tmpfs there; an ECS Fargate scratch volume copies the
# permissions of a declared VOLUME (1777 here) and is otherwise root-owned 0755.
VOLUME ["/tmp"]

EXPOSE 8589
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"

# Health probes are orchestrator-owned and target GET /api/actuator/health on :8589.
ENTRYPOINT ["java", "-jar", "app.jar"]
