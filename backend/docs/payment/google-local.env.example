# Save outside the repository as a private (0600) file, e.g. BlocBuy-Stripe-Local/google.env.
# The OAuth owner must register this exact callback; keep the shared CloudFront callback.
# Use a current development credential, not credentials previously pasted into chat.
GOOGLE_CLIENT_ID=REPLACE_WITH_DEVELOPMENT_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_DEVELOPMENT_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/oauth2/google/callback
