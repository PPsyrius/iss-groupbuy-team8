# Copy to a file OUTSIDE the repository. This file contains placeholders, not shared credentials.
# This is a shell env file; Spring Boot does not automatically load it.
# Enable Checkout only with a dedicated local Stripe Sandbox endpoint and test credentials.
# Test substitutes exist only in src/test and are never part of the application JAR.
SPRING_PROFILES_ACTIVE=local
BLOCBUY_STRIPE_CHECKOUT_ENABLED=true
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18589
SPRING_DATASOURCE_URL='jdbc:postgresql://127.0.0.1:55440/blocbuy_stripe_local?currentSchema=domain'
SPRING_DATASOURCE_USERNAME=stripe_local
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=56379
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_LOCAL_REDIS_PASSWORD
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
BLOCBUY_PAYMENT_CHECKOUT_SUCCESS_URL=http://127.0.0.1:5173/payments/return
BLOCBUY_PAYMENT_CHECKOUT_CANCEL_URL=http://127.0.0.1:5173/payments/return
STRIPE_API_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_CLI_SIGNING_SECRET
# Needed only for real browser Google login. Register this exact 127.0.0.1 callback in Google first.
# Never change the team's CloudFront callback to test your local application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:18589/api/v1/auth/oauth2/google/callback
