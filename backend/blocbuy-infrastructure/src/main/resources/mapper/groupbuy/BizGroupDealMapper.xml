<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blocbuy.groupbuy.persistence.BizGroupDealMapper">

    <select id="countOpenDeals" resultType="long">
        SELECT COUNT(*) FROM biz_group_deal
        WHERE deleted = false AND status = 'open'
          AND current_size &lt; target_size AND expire_time &gt; CURRENT_TIMESTAMP
    </select>

    <sql id="productReferences">
        FROM biz_group_deal WHERE product_id = #{productId,jdbcType=OTHER}
    </sql>
    <select id="existsProductReference" resultType="boolean">
        SELECT EXISTS (SELECT 1 <include refid="productReferences"/>)
    </select>
    <select id="countProductReferences" resultType="long">
        SELECT COUNT(*) <include refid="productReferences"/>
    </select>

    <resultMap id="bizGroupDealMap" type="com.blocbuy.groupbuy.persistence.BizGroupDealDO">
        <id column="id" property="id" jdbcType="OTHER"/>
        <result column="deal_no" property="dealNo"/>
        <result column="product_id" property="productId" jdbcType="OTHER"/>
        <result column="leader_user_id" property="leaderUserId" jdbcType="OTHER"/>
        <result column="deal_price" property="dealPrice"/>
        <result column="currency" property="currency"/>
        <result column="target_size" property="targetSize"/>
        <result column="current_size" property="currentSize"/>
        <result column="status" property="status"/>
        <result column="start_time" property="startTime"/>
        <result column="expire_time" property="expireTime"/>
        <result column="success_time" property="successTime"/>
        <result column="create_time" property="createTime"/>
        <result column="create_by" property="createBy" jdbcType="OTHER"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_by" property="updateBy" jdbcType="OTHER"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
    </resultMap>

    <sql id="columns">
        id, deal_no, product_id, leader_user_id, deal_price, currency, target_size, current_size,
        status, start_time, expire_time, success_time,
        create_time, create_by, update_time, update_by, deleted, version
    </sql>

    <select id="selectActiveById" resultMap="bizGroupDealMap">
        SELECT <include refid="columns"/>
        FROM biz_group_deal
        WHERE id = #{id,jdbcType=OTHER} AND deleted = false
    </select>

    <!-- Preserve open/unexpired eligibility; select one cheapest deal per product in PostgreSQL. -->
    <select id="selectBestOpenByProductIds" resultMap="bizGroupDealMap">
        SELECT DISTINCT ON (product_id) <include refid="columns"/>
        FROM biz_group_deal
        WHERE deleted = false AND status = 'open' AND expire_time &gt; CURRENT_TIMESTAMP
          AND product_id IN
        <foreach collection="productIds" item="productId" open="(" separator="," close=")">
            #{productId,jdbcType=OTHER}
        </foreach>
        ORDER BY product_id ASC, deal_price ASC, id ASC
    </select>
    <resultMap id="teamMembershipMap" type="com.blocbuy.groupbuy.persistence.TeamMembershipDO">
        <id column="member_id" property="memberId" jdbcType="OTHER"/>
        <result column="deal_id" property="dealId" jdbcType="OTHER"/>
        <result column="product_id" property="productId" jdbcType="OTHER"/>
        <result column="deal_price" property="dealPrice"/>
        <result column="currency" property="currency"/>
        <result column="target_size" property="targetSize"/>
        <result column="current_size" property="currentSize"/>
        <result column="status" property="status"/>
        <result column="expire_time" property="expireTime"/>
        <result column="success_time" property="successTime"/>
        <result column="member_role" property="memberRole"/>
        <result column="join_time" property="joinTime"/>
        <result column="order_id" property="orderId" jdbcType="OTHER"/>
    </resultMap>

    <!-- My Teams: page and count share this FROM/WHERE so total always matches the rows -->
    <sql id="membershipsOfUser">
        FROM biz_group_member m
        JOIN biz_group_deal d ON d.id = m.deal_id AND d.deleted = false
        WHERE m.user_id = #{userId,jdbcType=OTHER} AND m.deleted = false
    </sql>

    <select id="selectMembershipPageByUserId" resultMap="teamMembershipMap">
        SELECT m.id AS member_id, d.id AS deal_id, d.product_id, d.deal_price, d.currency,
               d.target_size, d.current_size, d.status, d.expire_time, d.success_time,
               m.member_role, m.join_time, m.order_id
        <include refid="membershipsOfUser"/>
        ORDER BY m.join_time DESC, m.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countMembershipsByUserId" resultType="long">
        SELECT COUNT(*)
        <include refid="membershipsOfUser"/>
    </select>

    <select id="selectActiveMemberIdsByDealId" resultType="java.util.UUID">
        SELECT user_id
        FROM biz_group_member
        WHERE deal_id = #{dealId,jdbcType=OTHER} AND deleted = false
        ORDER BY user_id
    </select>

</mapper>
