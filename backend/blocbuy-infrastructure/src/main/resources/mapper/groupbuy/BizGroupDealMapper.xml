<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blocbuy.groupbuy.persistence.BizGroupDealMapper">

    <select id="existsProductReference" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM biz_group_deal WHERE product_id = #{productId,jdbcType=OTHER})
    </select>

    <resultMap id="bizGroupDealMap" type="com.blocbuy.groupbuy.persistence.BizGroupDealDO">
        <id column="id" property="id" jdbcType="OTHER"/>
        <result column="deal_no" property="dealNo"/>
        <result column="product_id" property="productId" jdbcType="OTHER"/>
        <result column="leader_user_id" property="leaderUserId" jdbcType="OTHER"/>
        <result column="deal_price" property="dealPrice"/>
        <result column="currency" property="currency"/>
        <result column="target_size" property="targetSize"/>
        <result column="current_size" property="currentSize"/>
        <result column="status" property="status"/>
        <result column="start_time" property="startTime"/>
        <result column="expire_time" property="expireTime"/>
        <result column="success_time" property="successTime"/>
        <result column="create_time" property="createTime"/>
        <result column="create_by" property="createBy" jdbcType="OTHER"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_by" property="updateBy" jdbcType="OTHER"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
    </resultMap>

    <sql id="columns">
        id, deal_no, product_id, leader_user_id, deal_price, currency, target_size, current_size,
        status, start_time, expire_time, success_time,
        create_time, create_by, update_time, update_by, deleted, version
    </sql>

    <select id="selectActiveById" resultMap="bizGroupDealMap">
        SELECT <include refid="columns"/>
        FROM biz_group_deal
        WHERE id = #{id,jdbcType=OTHER} AND deleted = false
    </select>

    <!-- open = joinable now: status 'open' (server-side code) and not past expiry (DB clock) -->
    <select id="selectOpenByProductIds" resultMap="bizGroupDealMap">
        SELECT <include refid="columns"/>
        FROM biz_group_deal
        WHERE deleted = false AND status = 'open' AND expire_time &gt; CURRENT_TIMESTAMP
          AND product_id IN
        <foreach collection="productIds" item="productId" open="(" separator="," close=")">
            #{productId,jdbcType=OTHER}
        </foreach>
    </select>

</mapper>
