<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blocbuy.catalog.persistence.BizProductMapper">

    <resultMap id="bizProductMap" type="com.blocbuy.catalog.persistence.BizProductDO">
        <id column="id" property="id" jdbcType="OTHER"/>
        <result column="product_no" property="productNo"/>
        <result column="title" property="title"/>
        <result column="subtitle" property="subtitle"/>
        <result column="description" property="description"/>
        <result column="cover_image" property="coverImage"/>
        <result column="images" property="images" jdbcType="OTHER"/>
        <result column="category" property="category"/>
        <result column="original_price" property="originalPrice"/>
        <result column="currency" property="currency"/>
        <result column="stock" property="stock"/>
        <result column="sold_count" property="soldCount"/>
        <result column="status" property="status"/>
        <result column="pricing_mode" property="pricingMode"/>
        <result column="create_time" property="createTime"/>
        <result column="create_by" property="createBy" jdbcType="OTHER"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_by" property="updateBy" jdbcType="OTHER"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
    </resultMap>

    <sql id="columns">
        id, product_no, title, subtitle, description, cover_image, images, category,
        original_price, currency, stock, sold_count, status, pricing_mode,
        create_time, create_by, update_time, update_by, deleted, version
    </sql>

    <select id="selectActiveById" resultMap="bizProductMap">
        SELECT <include refid="columns"/>
        FROM biz_product
        WHERE id = #{id,jdbcType=OTHER} AND deleted = false
    </select>

    <select id="selectActiveByIdForUpdate" resultMap="bizProductMap">
        SELECT <include refid="columns"/>
        FROM biz_product
        WHERE id = #{id,jdbcType=OTHER} AND deleted = false
        FOR UPDATE
    </select>

    <!-- buyer browse shows on_sale only; 'on_sale' is a server-side status code, not user input -->
    <select id="selectOnSalePage" resultMap="bizProductMap">
        SELECT <include refid="columns"/>
        FROM biz_product
        WHERE deleted = false AND status = 'on_sale'
        <if test="category != null">
            AND category = #{category}
        </if>
        ORDER BY create_time DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countOnSale" resultType="long">
        SELECT COUNT(*)
        FROM biz_product
        WHERE deleted = false AND status = 'on_sale'
        <if test="category != null">
            AND category = #{category}
        </if>
    </select>

</mapper>
