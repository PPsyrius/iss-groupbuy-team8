target/
**/target/

# Allow only the verified application JAR into the Docker build context.
!blocbuy-bootstrap/target/
blocbuy-bootstrap/target/*
!blocbuy-bootstrap/target/blocbuy-backend.jar

docs/
*.md
.env
.env.*
docker-compose.yaml
.mvn/wrapper/maven-wrapper.jar.sha512

# Dockerfile.ci (CI pipeline) copies the prebuilt boot jar downloaded from the
# build-quality job — re-include it despite the target/ exclusions above.
!blocbuy-bootstrap/target/blocbuy-bootstrap-*.jar
