target/
**/target/

# Allow only the verified executable JAR into the Docker build context. The plain
# blocbuy-backend.jar (library for services/*-svc) stays out, so a Dockerfile that
# still copies it fails with "not found" instead of shipping a non-runnable image.
!blocbuy-bootstrap/target/
blocbuy-bootstrap/target/*
!blocbuy-bootstrap/target/blocbuy-backend-exec.jar

# SWE5001 service images (Dockerfile.ci with JAR=..., #456): only each service's boot JAR.
!services/*/target/
services/*/target/*
!services/*/target/*-svc.jar

docs/
*.md
.env
.env.*
docker-compose.yaml
.mvn/wrapper/maven-wrapper.jar.sha512
