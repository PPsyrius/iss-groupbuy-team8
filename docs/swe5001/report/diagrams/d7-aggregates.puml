@startuml d7-aggregates
skinparam classAttributeIconSize 0
skinparam Shadowing false

package "Identity Context" {
  class User <<aggregate root>> {
    +id: UUID
    +email: String
    +status: UserStatus
    +registerViaOAuth()
    +touchLogin(at: Instant)
    +ensureActive()
    +disable()
  }
  class OAuthIdentity <<entity>> {
    +provider: OAuthProvider
    +providerUserId: String
  }
  User "1" *-- "1..*" OAuthIdentity
}

package "Catalog Context" {
  class Product <<aggregate root>> {
    +id: UUID
    +originalPrice: BigDecimal
    +stock: int
    +status: ProductStatus
    +pricingMode: PricingMode
    +draft() / revise()
    +publish() / delist()
    +requireDeletable()
  }
  class ProductTeamTerms <<value object>> {
    +targetSize: Integer
    +lifetimeSeconds: Integer
    +startable(): boolean
  }
  class TeamPricePolicy <<aggregate root>> {
    +id: UUID
    +productId: UUID
    +amount: BigDecimal
    +validFrom: Instant
    +validUntil: Instant
    +requireQuotable(product, now)
  }
  Product "1" *-- "0..1" ProductTeamTerms
  TeamPricePolicy ..> Product : productId (ID ref)
}

package "GroupBuy Context" {
  class GroupDeal <<aggregate root>> {
    +id: UUID
    +productId: UUID
    +leaderUserId: UUID
    +dealPrice: BigDecimal
    +targetSize: int
    +currentSize: int
    +status: DealStatus
    +startTime: Instant
    +expireTime: Instant
    +joinPaid(payment, alreadyMember, now)
    +expire(now)
  }
  class PaidMember <<entity>> {
    +userId: UUID
    +paymentId: UUID
    +orderId: UUID
    +sharerUserId: UUID
    +role: MemberRole
  }
  class ParticipationReceipt <<entity>> {
    +paymentId: UUID
    +fingerprint: String
    +result: ParticipationResult
  }
  class ShareInvite <<value object>> {
    +id: UUID
    +ref: String
    +dealId: UUID
    +sharerUserId: UUID
    +mint(dealId, sharerId, rng)
    +attributes(dealId, buyerId)
  }
  class ShareCredit <<value object>> {
    +dealId: UUID
    +paymentId: UUID
    +sharerUserId: UUID
    +inviteeUserId: UUID
    +of(joined: MemberJoined)
  }
  GroupDeal "1" *-- "1..*" PaidMember
  GroupDeal "1" *-- "1..*" ParticipationReceipt
  GroupDeal ..> Product : productId (ID ref)
}

package "Ordering Context" {
  class PurchaseIntent <<aggregate root>> {
    +id: UUID
    +userId: UUID
    +operation: PurchaseOperation
    +dealId: UUID
    +productId: UUID
    +amount: BigDecimal
    +quoteValidUntil: Instant
    +businessDeadline: Instant
    +fulfilledPaymentId: UUID
    +sharerUserId: UUID
    +fulfilBy(paymentId: UUID)
    +expiredAt(now: Instant): boolean
  }
  class Order <<aggregate root>> {
    +id: UUID
    +paymentId: UUID
    +dealId: UUID
    +userId: UUID
    +totalAmount: BigDecimal
    +status: OrderStatus
    +create(terms, paidAt)
    +confirm()
    +cancel(at: Instant)
  }
  Order ..> GroupDeal : dealId (ID ref)
}

package "Payment & Notification Contexts" {
  class CheckoutPayment <<aggregate root>> {
    +id: UUID
    +quote: CheckoutQuote
    +status: Status
    +providerSessionId: String
    +bind() / succeed()
    +cancelUnpaid()
    +failTerminalUnpaid()
  }
  class CheckoutQuote <<value object>> {
    +intentId: UUID
    +userId: UUID
    +operation: String
    +businessId: UUID
    +amount: BigDecimal
    +expiredAt(now: Instant)
  }
  class RefundWork <<aggregate root>> {
    +id: UUID
    +paymentId: UUID
    +amount: BigDecimal
    +status: String
    +version: int
  }
  class Notification <<aggregate root>> {
    +id: UUID
    +eventId: UUID
    +userId: UUID
    +type: NotificationType
    +referenceId: UUID
  }
  CheckoutPayment "1" *-- "1" CheckoutQuote
  RefundWork ..> CheckoutPayment : paymentId (ID ref)
}
@enduml
