%% frame: BlocBuy group buying
usecaseDiagram
    actor Visitor
    actor Buyer
    actor Admin
    actor Stripe["Stripe"] <<system>>
    rectangle "BlocBuy" {
        usecase UC1["Browse group deals"]
        usecase UC2["Sign in"]
        usecase UC4["Join a team"]
        usecase UC5["Pay for a team seat"]
        usecase UC7["Publish a listing"]
    }
    note N1["condition: the team admitted the buyer\nextension point: Payment"]
    UC4 : Payment
    Buyer --|> Visitor
    Visitor -- UC1
    Buyer -- UC4
    UC4 ..> UC2 : include
    UC5 ..> UC4 : extend
    N1 .. UC5
    Admin -- UC7
    UC7 ..> UC2 : include
    UC5 -- Stripe
