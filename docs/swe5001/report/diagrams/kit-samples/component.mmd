%% frame: BlocBuy services by tier
componentDiagram
    actor Buyer
    rectangle "Presentation tier" {
        component Web["BlocBuy web app"] :::platform
    }
    package "Application tier" {
        interface IAuth["Auth API"]
        interface IDeals["Group deal API"]
        component Identity["identity-svc"] <<subsystem>> {
            component Iam["Identity and access"] <<bounded context>> : generic subdomain
        }
        component Commerce["commerce-svc"] <<subsystem>> {
            component Deals["Group buying"] <<bounded context>> :::business : core subdomain
            component Pay["Payments"] <<bounded context>> : supporting subdomain
        }
        component Notify["notification-svc"] <<subsystem>> {
            component Ntf["Notifications"] <<bounded context>> : generic subdomain
        }
    }
    rectangle "Integration tier" {
        component Events["Integration events"] <<topic>>
    }
    zone "Third party" {
        component Stripe["Stripe"] <<external system>>
    }
    rectangle "Data tier" {
        database Cache["Redis 8"]
        database Db["PostgreSQL 18"]
    }
    Buyer --> Web : HTTPS
    Identity -() IAuth
    Commerce -() IDeals
    Web -( IAuth : REST
    Web -( IDeals : REST
    Deals "D" ..> "U" Iam : Conformist
    Deals -- Pay : Partnership
    Pay "D" ..> "U" Stripe : ACL
    Ntf "D" ..> "U" Deals : OHS/PL
    Pay ..> Events : publishes
    Events ..> Notify : delivers
    Iam ..> Cache : sessions
    Ntf ..> Db : JDBC
