@startuml d4-context-map
skinparam componentStyle rectangle
skinparam Shadowing false

package "«service» identity-svc (Platform Service)" #F1F4FD {
  package "Identity & Access Context (Generic)" #FFFFFF {
    [User «AggregateRoot»\nOAuthIdentity «Entity»\nUserRepository · RoleRepository] as IDN
  }
}

package "«service» commerce-svc (Core Transactional Boundary)" #FDEFEC {
  package "Catalog & Pricing Context (Supporting)" #FFFFFF {
    [Product «AggregateRoot»\nTeamPricePolicy «AggregateRoot»\nProductTeamTerms «ValueObject»\nDualPricingStrategy «DomainService»] as CAT
  }
  package "GroupBuy Context (Core)" #FFF6E2 {
    [GroupDeal «AggregateRoot»\nPaidMember · ParticipationReceipt «Entity»\nShareInvite · ShareCredit «OwnRepository»\nPaidGroupDealCreator «Factory»] as GB
  }
  package "Ordering Context (Core)" #FFF6E2 {
    [PurchaseIntent «AggregateRoot»\nOrder «AggregateRoot»\nOrderFulfilmentAdapter] as ORD
  }
  package "Payment & Refund Context (Supporting)" #FFFFFF {
    [CheckoutPayment «AggregateRoot»\nRefundWork · PaymentReviewCase «AggregateRoot»\nCheckoutQuote «ValueObject»] as PAY
  }
  [IntegrationOutboxWriter\n(BEFORE_COMMIT → sys_outbox)] as OUTBOX
}

package "«service» notification-svc (Platform Service)" #F1F4FD {
  package "Notification Context (Generic)" #FFFFFF {
    [Notification «AggregateRoot»\nConsumedMessageRepository\nSqsNotificationEventConsumer] as NOTIF
  }
}

package "Shared Kernel (common)" #F3F3F3 {
  [ErrorCode · BizException · UuidV7\nPageQuery · RoleCode · LeasedJobRunner] as SK
}

[Google OAuth 2.0] <<external system>> as GOOGLE
[TypeSafe Reranker] <<external system>> as TYPESAFE
[Stripe API & Webhooks] <<external system>> as STRIPE
queue "Audit Queue (+ DLQ)\nFuture Analytics / Batch Consumer" as AUDIT

GOOGLE -left-> IDN : U → D: ACL\n(OAuthIdentityGateway)
TYPESAFE -left-> CAT : U → D: ACL (fail-open)\n(ListingSearchReranker)
STRIPE -left-> PAY : U → D: ACL\n(CheckoutGateway, RefundGateway)

IDN -down-> ORD : U → D: Customer/Supplier + OHS\nSync HTTP UserAppService (/internal/users/**)\n+ Shared Valkey RBAC Snapshot
CAT -down-> ORD : U → D: Customer/Supplier\nCatalogPurchaseSupport (price, consumeOneUnit)
GB -left-> CAT : U → D: Customer/Supplier\nGroupDealQueryService → GroupDealOffer
GB <--> ORD : Partnership (Same Local ACID Txn)\nOrderFulfilmentAdapter + BEFORE_COMMIT\nTeamSucceeded / TeamExpired (@Order 10)
PAY -left-> ORD : U → D: Conformist\nPaymentIntentPort, PaymentBusinessPort,\nPaymentSucceeded
GB -down-> PAY : U → D: Published Language (In-Process)\nTeamExpired BEFORE_COMMIT (@Order 20)

GB --> OUTBOX : TeamSucceeded, TeamExpired
PAY --> OUTBOX : PaymentSucceeded
OUTBOX -down-> NOTIF : U → D: Published Language + Event Enrichment\nTeamSucceededV1, TeamExpiredV1, PaymentSucceededV1\n(Async via Outbox → SNS → SQS)
OUTBOX -down-> AUDIT : U → D: Published Language\n(Filtered on Team* events)
@enduml
