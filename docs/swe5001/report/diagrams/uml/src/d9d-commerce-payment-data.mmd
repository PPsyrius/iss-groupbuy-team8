%% at biz_payment 1,1
%% at biz_refund 2,1
%% at sys_scheduled_item_retry 3,1
%% at log_payment_review 0,2
%% at biz_payment_review_case 1,2
%% at log_refund_attempt 2,2
%% at sys_checkout_expiry_cursor 3,2
    biz_purchase_intent "1" .. "0..*" biz_payment
    biz_payment "1" .. "0..1" biz_order
    biz_payment "0..1" .. "0..*" log_payment_webhook_event
    biz_payment "1" .. "0..*" log_payment_review
    biz_payment "1" .. "0..1" biz_payment_review_case
    biz_payment "1" .. "0..1" biz_refund
    biz_refund "1" .. "0..*" log_refund_attempt
