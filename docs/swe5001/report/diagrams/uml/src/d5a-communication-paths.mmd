%% frame: BlocBuy SWE5001 communication paths
deploymentDiagram
    device Browser["Buyer's browser"]
    node Cdn["Amazon\nCloudFront"] <<global edge>>
    node Stripe["Stripe"] <<external system>>
    node Google["Google Sign-In"] <<external system>>
    node S3["Amazon S3"] <<bucket>> : SPA files (OAC)
    zone "VPC 10.50.0.0/16" {
        zone "Public" {
            node Alb["Application\nLoad Balancer"]
            node Nat["fck-nat"]
        }
        zone "Private" {
            environment Fg["ECS Fargate, Arm64"] {
                environment IdT["identity-svc task"]
                environment CoT["commerce-svc task"]
                environment NtT["notification-svc task"]
            }
        }
        zone "Data" {
            node Cache["ElastiCache\nValkey"] : TLS 6379
            node Rds["RDS PostgreSQL"] : TLS 5432
        }
    }
    zone "SNS and SQS" as Msg {
        node Sns["domain-events"] <<SNS topic>> :::messaging
        node QNt["notification"] <<SQS queue>> :::messaging : and its DLQ
        node QAu["audit"] <<SQS queue>> :::messaging : and its DLQ
    }
    Browser -- Cdn : HTTPS 443
    Cdn --> S3 : HTTPS
    Stripe --> Cdn : HTTPS 443
    Cdn --> Alb : HTTP 80, origin secret
    Alb --> Fg : HTTP 8589
    CoT --> IdT : HTTP 8589
    IdT --> Cache
    CoT --> Cache
    NtT --> Cache
    IdT --> Rds
    CoT --> Rds
    NtT --> Rds
    IdT --> Nat : HTTPS 443
    CoT --> Nat : HTTPS 443
    NtT --> Nat : HTTPS 443
    Nat --> Stripe : HTTPS 443
    Nat --> Google : HTTPS 443
    Nat --> Sns : publish
    Nat --> QNt : long poll
    Sns --> QNt
    Sns --> QAu
