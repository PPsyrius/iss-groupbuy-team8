%% frame: In-process domain events in commerce-svc
componentDiagram
    component Commerce["commerce-svc"] <<subsystem>> {
        component Pay["StripeCheckoutService"] <<application service>> : publishes PaymentSucceeded
        component Deals["PaidGroupDealService"] <<application service>> : publishes MemberJoined, TeamSucceeded
        component Expiry["GroupDealExpiryService"] <<application service>> : publishes TeamExpired
        component Bus["ApplicationEventPublisher"] <<in-process event bus>> :::messaging
        component RefundSub["TeamExpiryRefundSubscriber"] <<subscriber>> : on TeamExpired; BEFORE_COMMIT, @Order(20)
        component OrderSub["OrderLifecycleSubscriber"] <<subscriber>> : on TeamSucceeded, TeamExpired; BEFORE_COMMIT, @Order(10)
        component Writer["IntegrationOutboxWriter"] <<subscriber>> : on PaymentSucceeded, TeamSucceeded, TeamExpired; BEFORE_COMMIT, lowest precedence
        component CreditSub["ShareCreditSubscriber"] <<subscriber>> : on MemberJoined; AFTER_COMMIT, REQUIRES_NEW
        component CacheSub["OpenDealOfferCacheSubscriber"] <<subscriber>> : on MemberJoined, TeamSucceeded, TeamExpired; AFTER_COMMIT
        database Outbox["Commerce data store\n(sys_outbox)"]
    }
    Pay ..> Bus : «use»
    Deals ..> Bus : «use»
    Expiry ..> Bus : «use»
    RefundSub ..> Bus : «use»
    OrderSub ..> Bus : «use»
    Writer ..> Bus : «use»
    CreditSub ..> Bus : «use»
    CacheSub ..> Bus : «use»
    Writer ..> Outbox : inserts V1 envelope
