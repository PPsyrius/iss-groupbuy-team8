%% frame: CI on a pull request into dev, then on dev
activityDiagram
    lane "GitHub: dev" {
        start S
        fork F
        join J
        decision Gate
        end EB
        action Merge["Squash\nmerge"]
    }
    lane "ci-backend.yml" {
        action BQ["build-quality:\nMaven verify,\nCheckstyle"]
        fork FB
        action CC["contract-check"]
        action Sonar["SonarCloud\nBackend"]
        action Dock["docker: build\nimage, boot\nsmoke test,\nTrivy image scan"]
        action DevPath["On dev:\npackage-dev,\npublish-ecr-dev,\ndeploy-existing-ec2"]
        end E
    }
    lane "security.yml" {
        action Sec["gitleaks,\ntrivy-deps,\ntrivy-config\n(codeql is off)"]
    }
    lane "swe5001-service-images.yml" {
        decision TrigI
        action Imgs["Package the JAR\n(no tests), build\nARM64 image,\nTrivy image scan"]
        merge MI
    }
    lane "infra-swe5001.yml" {
        decision TrigP
        action Static["static: terraform\ntest (mocked\nprovider), Checkov,\nTrivy config"]
        action Plan["plan: foundation\nonly"]
        merge MP
    }
    S --> F
    F --> BQ
    F --> Sec
    F --> TrigI
    F --> TrigP
    BQ --> FB
    FB --> CC
    FB --> Sonar
    CC --> Dock
    Dock --> J
    Sonar --> J
    Sec --> J
    TrigI --> Imgs : [files changed]
    TrigI --> MI : [else]
    Imgs --> MI
    MI --> J
    TrigP --> Static : [files changed]
    TrigP --> MP : [else]
    Static --> Plan
    Plan --> MP
    MP --> J
    J --> Gate
    Gate --> Merge : [green, approved]
    Gate --> EB : [else]
    Merge --> DevPath
    DevPath --> E
