%% frame: BlocBuy SWE5001 distributed environment, Region ap-southeast-1
deploymentDiagram
    device Browser["Buyer's browser"]
    node Cdn["Amazon CloudFront"] <<global edge>>
    node Stripe["Stripe"] <<external system>>
    node Google["Google Sign-In"] <<external system>>
        node Vpc["VPC 10.50.0.0/16"] {
            node AzA["AZ ap-southeast-1a"] {
                zone "Public 10.50.0.0/24" {
                    node AlbA["ALB node"] : HTTP 80 listener
                    node Nat["fck-nat"] : t4g.nano, Elastic IP
                }
                zone "Private 10.50.10.0/24" {
                    environment FgA["ECS Fargate, Arm64"] : 0.5 vCPU, 1 GiB per task {
                        artifact IdA["identity-svc"] : image
                        artifact CoA["commerce-svc"] : image
                        artifact NtA["notification-svc"] : image
                    }
                }
                zone "Data 10.50.20.0/24" {
                    node Cache["ElastiCache Valkey 8.0"] : cache.t4g.micro, 1 node
                }
            }
            node AzB["AZ ap-southeast-1b"] {
                zone "Public 10.50.1.0/24" {
                    node AlbB["ALB node"] : HTTP 80 listener
                }
                zone "Private 10.50.11.0/24" {
                    environment FgB["ECS Fargate, Arm64"] : 0.5 vCPU, 1 GiB per task {
                        artifact IdB["identity-svc"] : image
                        artifact CoB["commerce-svc"] : image
                        artifact NtB["notification-svc"] : image
                    }
                }
                zone "Data 10.50.21.0/24" {
                    node Rds["RDS PostgreSQL 18"] : db.t4g.micro, single zone, 3 databases
                }
            }
        }
        node S3["Amazon S3"] <<bucket>> : SPA files
        note Tasks["Tasks per service,\nboth zones together:\nidentity-svc 1,\ncommerce-svc 2 to 6,\nnotification-svc\n1 to 4. ECS places\neach task in either\nprivate subnet."]
        node Sns["domain-events"] <<SNS topic>> :::messaging
        node QNt["notification"] <<SQS queue>> :::messaging : and its DLQ
        node QAu["audit"] <<SQS queue>> :::messaging : and its DLQ
