%% frame: BlocBuy logical view: published events and data stores by tier
componentDiagram
    package "Application tier" as AppT {
        component IdSvc["identity-svc"] <<subsystem>>
        component CoSvc["commerce-svc"] <<subsystem>> :::business
        component NtSvc["notification-svc"] <<subsystem>>
    }
    interface IEv["PublishedEvents V1"]
    package "Integration tier" {
        component Broker["Message\nbroker"] :::messaging
        component NQ["Event queue\n(notification)"] :::messaging
        component AQ["Event queue\n(audit)"] :::messaging : no consumer
    }
    package "Data tier" {
        database Sess["Session store"]
        database IdDb["Identity\ndata store"]
        database CoDb["Commerce\ndata store"]
        database NtDb["Notification\ndata store"]
    }
    CoSvc -() IEv : async
    Broker -( IEv : async
    Broker --> NQ
    Broker --> AQ
    NtSvc ..> NQ : async
    IdSvc ..> IdDb : sync
    CoSvc ..> CoDb : sync
    NtSvc ..> NtDb : sync
    AppT ..> Sess : sync
