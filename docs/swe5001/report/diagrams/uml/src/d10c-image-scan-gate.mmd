%% frame: Image scan gate in the two image jobs
activityDiagram
    lane "ci-backend.yml: docker" {
        start SB
        action BB["Build the\nmonolith image"]
        action HB["Smoke test:\nboot, health\ncheck"]
        action TB["Trivy image\nscan: fixable\nHIGH or\nCRITICAL"]
        decision VB
        action FB["Job fails:\ndocker check\nred, merge\nblocked"]
        end EFB
        end EB
    }
    lane "swe5001-service-images.yml: build" {
        start SI
        action PI["Package the\nJAR (no tests)"]
        action BI["Build the\nARM64 image,\nload it into\nDocker"]
        action TI["Trivy image\nscan: fixable\nHIGH or\nCRITICAL"]
        decision VI
        action FI["Job fails:\nservice-images\nred: prod\ncheck blocks\npromotion; dev\nmerge stops by\nteam rule"]
        end EFI
        decision UP
        action EX["Export the\nscanned image\n(docker save),\nupload it"]
        end EI
        end EN
    }
    SB --> BB
    BB --> HB
    HB --> TB
    TB --> VB
    VB --> FB : [found]
    FB --> EFB
    VB --> EB : [none]
    SI --> PI
    PI --> BI
    BI --> TI
    TI --> VI
    VI --> FI : [found]
    FI --> EFI
    VI --> UP : [none]
    UP --> EX : [upload-images]
    UP --> EN : [else]
    EX --> EI
