%% frame: BlocBuy logical view: request interfaces by tier
componentDiagram
    actor Admin["Platform administrator"] <<producer>>
    actor Leader["Team leader"] <<producer>>
    actor Member["Member"] <<consumer>>
    package "Presentation tier" {
        component Web["Web client"] :::platform
        component Edge["CDN and edge gateway"]
    }
    interface IAuth["AuthAPI"]
    interface ICom["CommerceAPI"]
    interface INtf["NotificationAPI"]
    package "Application tier" {
        component IdSvc["identity-svc"] <<subsystem>>
        interface IUser["UserAppService"]
        component CoSvc["commerce-svc"] <<subsystem>> {
            component Catalog["Catalog"]
            component GroupBuy["GroupBuy"] :::business
            component Order["Order"] :::business
            component Payment["Payment"]
        }
        component NtSvc["notification-svc"] <<subsystem>>
        interface IOidc["OIDC sign-in"]
        interface IEv["PublishedEvents V1"]
        interface IHook["PaymentWebhookAPI"]
    }
    interface IPay["CheckoutAPI"]
    component IdP["Identity provider"] <<external system>>
    component PayP["Payment provider"] <<external system>>
    Admin --> Web
    Leader --> Web
    Member --> Web
    Web ..> Edge : sync
    Edge -( IAuth : sync
    Edge -( ICom : sync
    Edge -( INtf : sync
    IdSvc -() IAuth
    CoSvc -() ICom
    NtSvc -() INtf
    IdSvc -() IUser
    CoSvc -( IUser : sync
    IdSvc -( IOidc : sync
    IdP -() IOidc
    CoSvc -() IEv : async
    Payment -() IHook
    PayP -( IHook : sync
    Payment -( IPay : sync
    PayP -() IPay
