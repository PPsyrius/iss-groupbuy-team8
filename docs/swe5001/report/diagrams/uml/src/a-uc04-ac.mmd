%% frame: UC4 Join an existing team by paying (analysis)
classDiagram
    class JoinTeamUI {
        <<boundary>>
        +join(team, invitation)
        +showJoined(teamStatus)
        +showRejected(reason)
    }
    class Account {
        <<entity>>
        -status: AccountStatus
        +isActive()
    }
    class PayUpfrontControl {
        <<control>>
        +paymentReported(report)
    }
    class Product {
        <<entity>>
        -title: Text
        -stock: Count
        -status: ProductStatus
        +isPurchasable()
        +takeOneUnit()
    }
    class JoinTeamControl {
        <<control>>
        +requestJoin(buyer, team, invitation)
        +paymentConfirmed(payment)
    }
    class Payment {
        <<entity>>
        -amount: Money
        -status: PaymentStatus
        -outcome: PaymentOutcome
    }
    class Refund {
        <<entity>>
        -amount: Money
        -reason: Text
        -status: RefundStatus
    }
    class Order {
        <<entity>>
        -amount: Money
        -status: OrderStatus
    }
    class ResolveTeamControl {
        <<control>>
        +teamFilled(team)
    }
    class Team {
        <<entity>>
        -price: Money
        -targetSize: Count
        -currentSize: Count
        -deadline: Date-time
        -status: TeamStatus
        +resolveSharer(invitation, buyer)
        +checkAdmission(buyer)
        +admit(buyer, payment)
    }
    class PurchaseIntent {
        <<entity>>
        -price: Money
        -payableUntil: Date-time
        -teamDeadline: Date-time
        +isPayable()
        +fulfilBy(payment)
    }
    class Membership {
        <<entity>>
        -role: MemberRole
        -joinTime: Date-time
    }
    class Invitation {
        <<entity>>
        -reference: Text
        +attributes(team, buyer)
    }
