%% frame: UC9 B7, A3: team terms with an optional team price (design)
sequenceDiagram
    participant Ctl as :AdminListingController
    participant App as :TeamTermsAppServiceImpl
    participant Prices as :TeamPriceAppServiceImpl
    participant Repo as :ProductRepository
    participant Users as :UserAppService
    participant Prod as :Product
    participant Spec as TeamTermsSpecification
    participant PRepo as :TeamPriceRepository
    create participant Pol as :TeamPricePolicy
    create participant Chg as :TeamTermsChange

    Ctl->>App: B7: configure(productId, command, actorId)
    critical REQUIRED, READ COMMITTED, 10 s
        App->>Repo: lockById(productId): row lock
        App->>Users: requireActive(actorId)
        App->>Prod: requireVersion(expectedVersion)
        App->>Prod: configureTeamTerms(targetSize, lifetimeSeconds)
        Prod->>Spec: violations(targetSize, lifetimeSeconds)
        break size below 2, or lifetime outside 2400-86400 s (E8)
            Prod-->>App: TEAM_TERMS_INVALID (CATALOG_400_003)
        end
        App->>Repo: updateTeamTerms(revised, expectedVersion, actorId)
        opt team price sent (B7), joining this transaction
            App->>Prices: configure(productId, actorId, price)
            Prices->>Repo: lockById(productId) in lockProduct: row held in B7
            Prices->>Users: requireActive(actorId)
            Prices->>PRepo: findLatestPolicy(productId)
            break expectedVersion is not the latest policy version (E8)
                Prices-->>App: TEAM_PRICE_VERSION_CONFLICT (CATALOG_412_001)
            end
            Prices->>Pol: «create» (command fields, version + 1)
            Prices->>Pol: requireCompatible(product)
            Prices->>Pol: requireStartableWindow(now)
            break not on sale, price not below the listing price, window past or too short (E8)
                Pol-->>App: TEAM_PRICE_UNAVAILABLE (CATALOG_409_001), TEAM_PRICE_INVALID (CATALOG_400_001); terms roll back
            end
            Prices->>PRepo: appendPolicy(policy, actorId, now)
        end
        App->>Chg: «create» (previous, current, versions, actorId)
        App->>Repo: appendTeamTermsLog(change)
    end
    App-->>Ctl: TeamTermsResult
