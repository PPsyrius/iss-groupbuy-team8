%% frame: Promotion into prod and the SWE5001 environment
activityDiagram
    lane "swe5001-release-gate.yml" {
        start S
        action PR["Open the promotion\nPR, dev into prod"]
        action PS["promotion-source:\nhead is our dev"]
        decision SourceOk
        flowend SourceFailed
        fork FG
        action SI["service-images: build\nand scan, no export"]
        action IP["infra-plan:\ninfra-swe5001 checks"]
        join J
        decision G
        flowend EB
        action Merge["Merge commit\ninto prod"]
        flowend E1
    }
    lane "swe5001-deploy.yml (enabled prod run)" {
        start S3
        action Img["images: build,\nscan, export"]
        decision D1
        action Pub["publish: push to ECR,\ncandidate digests"]
        decision D2
        merge F2
        action Up["up: env-up.sh\n--candidate,\nsmoke suite"]
        decision Ok
        merge F3
        action Rel["release: publish SPA,\npromote the digests"]
        merge M
        action Down["down (always):\nattempt destroy\nand absence check"]
        action Ev["evidence (always):\nattempt receipt merge"]
        flowend E
    }
    lane "swe5001-env.yml" {
        start S2
        action Cron["Nightly at 23:00 SGT\n(cron 0 15 * * *)"]
        action Disp["dispatch (on dev):\nstart down on prod"]
        action Sess["session (on prod):\nenv-down.sh"]
        flowend E2
    }
    S --> PR
    PR --> PS
    PS --> SourceOk
    SourceOk --> FG : [passed]
    SourceOk --> SourceFailed : [failed]
    FG --> SI
    FG --> IP
    SI --> J
    IP --> J
    J --> G
    G --> Merge : [3 checks green, approved]
    G --> EB : [else]
    Merge --> E1
    S3 --> Img
    Img --> D1
    D1 --> Pub : [passed]
    D1 --> F2 : [failed]
    Pub --> D2
    D2 --> Up : [passed]
    D2 --> F2 : [failed]
    F2 --> F3
    Up --> Ok
    Ok --> Rel : [passed]
    Ok --> F3 : [failed]
    F3 --> M
    Rel --> M
    M --> Down
    Down --> Ev : [any outcome]
    Ev --> E
    S2 --> Cron
    Cron --> Disp
    Disp --> Sess
    Sess --> E2
