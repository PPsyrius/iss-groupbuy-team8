%% frame: Aggregates of purchase intent and payment
classDiagram
    class PurchaseIntentTerms["PurchaseIntent.Terms"] {
        <<value object, record>>
        +userId: UUID
        +operation: PurchaseOperation
        +dealId: UUID
        +productId: UUID
        +amount: BigDecimal
        +targetSize: int
    }
    class PurchaseIntent {
        <<aggregate root>>
        -id: UUID
        -quoteValidUntil: Instant
        -businessDeadline: Instant
        -fulfilledPaymentId: UUID
        -sharerUserId: UUID
        -expiredAt: Instant
        -version: int
        +issue(terms: PurchaseIntent.Terms, quoteValidUntil: Instant, businessDeadline: Instant, now: Instant): PurchaseIntent «static»
        +attributedTo(sharer: UUID): PurchaseIntent
        +fulfilBy(paymentId: UUID): PurchaseIntent
        +requireOwner(authenticatedUser: UUID): void
        +expireAt(now: Instant): PurchaseIntent
        +fulfilled(): boolean
    }
    class RefundWork {
        <<record, data object>>
        +id: UUID
        +paymentId: UUID
        +amount: BigDecimal
        +providerRefundId: String
        +firstAttemptAt: Instant
        +version: int
        +valid(): boolean
    }
    class CheckoutQuote {
        <<value object, record>>
        +intentId: UUID
        +userId: UUID
        +operation: String
        +businessId: UUID
        +amount: BigDecimal
        +currency: String
        +quoteValidUntil: Instant
        +businessDeadline: Instant
    }
    class CheckoutPayment {
        <<aggregate root, record>>
        +id: UUID
        +requestKey: String
        +sessionId: String
        +providerPaymentIntentId: String
        +version: int
        +bind(session: String, url: String, intent: String): CheckoutPayment
        +succeed(): CheckoutPayment
        +cancelUnpaid(): CheckoutPayment
        +failTerminalUnpaid(): CheckoutPayment
    }
    class CheckoutPaymentStatus["CheckoutPayment.Status"] {
        <<enumeration>>
        CREATED
        SUCCEEDED
        FAILED
        CANCELED
    }
%% at PurchaseIntentTerms 0,0
%% at PurchaseIntent 1,0
%% at CheckoutQuote 0,1
%% at CheckoutPayment 1,1
%% at RefundWork 0,2
%% at CheckoutPaymentStatus 1,2
    PurchaseIntent *-- PurchaseIntentTerms : terms
    CheckoutPayment *-- CheckoutQuote : quote
    CheckoutPayment --> CheckoutPaymentStatus : status
    CheckoutQuote ..> PurchaseIntent : id
    PurchaseIntent ..> CheckoutPayment : id
    RefundWork ..> CheckoutPayment : id
