%% frame: After the expiry, part 1: the refund worker retries until Stripe answers (design)
sequenceDiagram
    participant Job as :RefundWorkerJob
    participant Svc as :RefundService
    participant Repo as :RefundRepository
    participant GW as :StripeRefundGateway
    actor Stripe as stripe : Stripe

    loop PT30S after its previous run, under the lease "refund-worker", while the obligation is pending or processing
        Job->>Svc: processNext()
        critical claim, REQUIRED (new), READ COMMITTED, 5 s
            Svc->>Repo: claimNext()
            Repo-->>Svc: RefundWork
            Note over Svc,Repo: oldest due row, SKIP LOCKED, 2 min row lease
        end
        break nothing due
            Svc-->>Job: false
        end
        Note over Svc,Stripe: no transaction is open during the provider call
        alt providerRefundId is stored
            Svc->>GW: retrieveRefund(providerRefundId)
            GW->>Stripe: GET /v1/refunds/{id}
        else no refund id, and the database clock now() is 23 h or more past firstAttemptAt
            Svc->>GW: findRefund(work) {never create again}
            GW->>Stripe: GET /v1/refunds?payment_intent=…
        else no refund id, under 23 h
            Svc->>GW: createRefund(work)
            GW->>Stripe: POST /v1/refunds, Idempotency-Key providerKey()
        end
        Stripe-->>GW: Refund, or a list of refunds
        GW-->>Svc: Snapshot, or BizException
        Note over Svc,Repo: each finish is its own transaction (REQUIRED new, 5 s)
        alt pending, or a transient provider error: PROCESSING, due again in 30 s
            Svc->>Repo: finish(work, providerId, state, result)
        else succeeded, failed, mismatch, permanent refusal or none found: SUCCEEDED, FAILED or REVIEW
            Svc->>Repo: finish(work, providerId, state, result)
        end
        Svc-->>Job: true
    end
