%% frame: Integration events from commerce-svc to their consumers
componentDiagram
    component Commerce["commerce-svc"] <<subsystem>> {
        component Writer["IntegrationOutboxWriter"] <<subscriber>>
        database Outbox["sys_outbox"] <<table>>
        component Relay["OutboxRelayService"] <<application service>> : run by OutboxRelayJob
    }
    component Topic["Domain event topic"] <<topic>> :::messaging
    component QN["notification queue"] <<queue>> :::messaging : DLQ after 5 receives
    component QA["audit queue"] <<queue>> :::messaging : DLQ after 5 receives
    component Notify["notification-svc"] <<subsystem>> {
        component Consumer["SqsNotificationEventConsumer"] <<consumer>>
        component Handler["NotificationEventAppService"] <<application service>> : one notice per event and user
    }
    note Later["No consumer. A new consumer subscribes its own queue to the topic; commerce-svc does not change."]
    Writer ..> Outbox : inserts V1 envelope
    Relay ..> Outbox : claims due rows
    Relay ..> Topic : publishes V1 events
    Topic ..> QN : eventType in three types
    Topic ..> QA : eventType prefix Team
    Consumer ..> QN : polls
    Consumer ..> Handler : handle
    Later .. QA
