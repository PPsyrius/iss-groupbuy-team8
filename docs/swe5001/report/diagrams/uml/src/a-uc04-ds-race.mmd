%% frame: UC4 A7: two payments race for the last seat (design)
sequenceDiagram
    participant App as :StripePaymentAppService
    participant A as txA : StripeCheckoutService
    participant B as txB : StripeCheckoutService
    participant OFA as :OrderFulfilmentAdapter
    participant Groups as :PaidGroupDealService
    participant Repo as :CheckoutPaymentRepository

    activate App
    Note over App,B: A7, at B7: two verified webhooks (@fig-a-pay-ds-webhook), one thread each
    par buyer X's webhook
        App->>A: handleWebhook(rawX, sigX)
        activate A
        critical txA: settlement, REQUIRED, READ COMMITTED, 10 s
            A->>OFA: lockForSettlement(quoteX): lock 1, then lock 2
            activate OFA
            OFA-->>A: void
            deactivate OFA
            A->>OFA: fulfil(eventX)
            activate OFA
            OFA->>Groups: joinConfirmed(dealId, paidX, sharer)
            activate Groups
            Groups-->>OFA: applied, team SUCCEEDED
            deactivate Groups
            OFA-->>A: Outcome(dealId, orderX, null)
            deactivate OFA
            Note over A,OFA: COMMIT releases lock 1
        end
        A-->>App: void
        deactivate A
    and buyer Y's webhook
        App->>B: handleWebhook(rawY, sigY)
        activate B
        Note over B,OFA: waits on lock 1 (team) until operand 1 commits
        critical txB: settlement, REQUIRED, READ COMMITTED, 10 s
            B->>OFA: lockForSettlement(quoteY): lock 1, granted after txA's commit
            activate OFA
            OFA-->>B: void
            deactivate OFA
            B->>OFA: fulfil(eventY)
            activate OFA
            OFA->>Groups: joinConfirmed(dealId, paidY, sharer)
            activate Groups
            Groups-->>OFA: compensation_required, DEAL_CLOSED
            deactivate Groups
            OFA-->>B: Outcome(dealId, null, "GROUP_REJECTED")
            deactivate OFA
            B->>Repo: requireRefund(paymentY, "GROUP_REJECTED", eventY)
            activate Repo
            deactivate Repo
            B->>Repo: recordOutcome(paymentY, dealId, null, "REFUND_REQUIRED")
            activate Repo
            deactivate Repo
            Note over B,Repo: COMMIT
        end
        B-->>App: void
        deactivate B
    end
    deactivate App
