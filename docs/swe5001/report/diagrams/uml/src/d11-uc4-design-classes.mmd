%% frame: UC4 design classes across the COLA layers: adapter, application, domain, infrastructure (commerce-svc)
classDiagram
    class StripeWebhookController {
        <<controller, Ext, Sec>>
        +handleStripeEvent(payload: String, signatureHeader: String): Result~Void~
    }
    class PaymentAppService {
        <<interface>>
        +handleStripeWebhook(payload: String, signatureHeader: String): void
    }
    class StripePaymentAppService {
        <<application service, Ext>>
    }
    class StripeCheckoutService {
        <<application service, Ext, Conc>>
        -tx: TransactionTemplate
        +handleWebhook(rawBody: String, signature: String): void
    }
    class OrderFulfilmentAdapter {
        <<adapter, application service, Dist, Conc>>
        +lockForSettlement(quote: CheckoutQuote): void
        +fulfil(event: PaymentSucceeded): PaymentBusinessPort.Outcome
    }
    class PaidGroupDealService {
        <<application service, Conc, Evt>>
        +joinConfirmed(dealId: UUID, paid: PaidParticipation, sharerUserId: UUID): ParticipationResult
    }
    class CheckoutPayment {
        <<aggregate root, record>>
        +status: CheckoutPayment.Status
        +succeed(): CheckoutPayment
    }
    class CheckoutPaymentRepository {
        <<interface, repository, Pers, Conc>>
        +lock(id: UUID): CheckoutPayment
        +requireRefund(payment: CheckoutPayment, reason: String, eventId: String): void
    }
    class PaymentBusinessPort {
        <<interface, Dist, Conc>>
        +lockForSettlement(quote: CheckoutQuote): void
        +fulfil(event: PaymentSucceeded): PaymentBusinessPort.Outcome
    }
    class GroupDeal {
        <<aggregate root, Pers>>
        -targetSize: int
        -currentSize: int
        -status: DealStatus
        +joinPaid(payment: PaidParticipation, alreadyMember: boolean, now: Instant): PaidAdmission
    }
    class PaidGroupDealRepository {
        <<interface, repository, Pers, Conc>>
        +lockDeal(dealId: UUID): Optional~GroupDeal~
    }
    class PaidGroupDealMapper {
        <<interface, mapper, Pers, Conc>>
        +updateDeal(deal: BizGroupDealDO, expectedSize: int, expectedStatus: String): int
    }
    class PaidGroupDealRepositoryImpl {
        <<adapter, Pers>>
    }
    class CheckoutPaymentRepositoryImpl {
        <<adapter, Pers>>
    }
%% at StripeWebhookController 0,0
%% at PaymentAppService 0,1
%% at StripePaymentAppService 1,1
%% at StripeCheckoutService 2,1
%% at OrderFulfilmentAdapter 3,1
%% at PaidGroupDealService 4,1
%% at CheckoutPayment 0,2
%% at CheckoutPaymentRepository 1,2
%% at PaymentBusinessPort 2,2
%% at GroupDeal 3,2
%% at PaidGroupDealRepository 4,2
%% at PaidGroupDealMapper 3,3
%% at PaidGroupDealRepositoryImpl 4,3
%% at CheckoutPaymentRepositoryImpl 1,3
    StripeWebhookController "1" --> "1" PaymentAppService
    StripePaymentAppService ..|> PaymentAppService
    StripePaymentAppService "1" --> "0..1" StripeCheckoutService
%% mside StripePaymentAppService StripeCheckoutService left right
    StripeCheckoutService "1" --> "1" CheckoutPaymentRepository
%% mside StripeCheckoutService CheckoutPaymentRepository left left
    StripeCheckoutService "1" --> "1" PaymentBusinessPort
    OrderFulfilmentAdapter ..|> PaymentBusinessPort
    OrderFulfilmentAdapter "1" --> "1" PaidGroupDealService
    PaidGroupDealService "1" --> "1" PaidGroupDealRepository
    PaidGroupDealService ..> GroupDeal
    PaidGroupDealRepository ..> GroupDeal
    CheckoutPaymentRepository ..> CheckoutPayment
    PaidGroupDealRepositoryImpl ..|> PaidGroupDealRepository
    PaidGroupDealRepositoryImpl "1" --> "1" PaidGroupDealMapper
    CheckoutPaymentRepositoryImpl ..|> CheckoutPaymentRepository
