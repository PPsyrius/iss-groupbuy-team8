@startuml d3-logical-view
skinparam componentStyle uml2
skinparam linetype polyline
skinparam Shadowing false
skinparam nodesep 25
skinparam ranksep 35

actor "Producer\n(Platform administrator)" as Producer
actor "Consumer\n(Buyer / Team Leader)" as Consumer

package "Presentation Tier" as PresentationTier {
  [Web SPA] <<component>> as SPA
  [CDN & Edge Gateway] <<component>> as Edge
}

package "Application Tier" as ApplicationTier {
  package "«subsystem» Platform Services" #F1F4FD {
    [Identity Service] <<component>> as IdentitySvc
    [Notification Service] <<component>> as NotificationSvc
  }
  package "«subsystem» Business Application" #FDEFEC {
    [Commerce Service\nCatalog · GroupBuy\nOrder · Payment · Outbox Relay] <<component>> as CommerceSvc
  }
}

package "Integration Tier" as IntegrationTier #FFF6E2 {
  [Message Broker\n(Topic Fan-out)] <<component>> as Broker
  [Notification Event Queue (+ DLQ)] <<component>> as NotifQueue
  [Audit Event Queue (+ DLQ)] <<component>> as AuditQueue
}

package "Data Tier" as DataTier {
  database "Session Store\nAuth / RBAC" <<database>> as SessionStore
  database "Identity Database" <<database>> as IdentityDB
  database "Commerce Database" <<database>> as CommerceDB
  database "Notification Database" <<database>> as NotifDB
}

package "External Systems" {
  [External OAuth Provider] <<external system>> as OAuthExt
  [External Payment Provider] <<external system>> as PaymentExt
}

' Explicit UML interface classifiers reserve room for names at report scale.
rectangle "AuthAPI" <<interface>> as IAuth
rectangle "NotificationAPI" <<interface>> as INotif
rectangle "CommerceAPI" <<interface>> as ICommerce
rectangle "UserStatusPort" <<interface>> as IUserPort #FDEFEC
rectangle "PaymentWebhookAPI" <<interface>> as IWebhook
rectangle "PublishedEventsV1" <<interface>> as IEvents

Producer --> SPA
Consumer --> SPA
SPA --> Edge : Sync HTTPS

Edge --> IAuth
IdentitySvc ..|> IAuth

Edge --> INotif
NotificationSvc ..|> INotif

Edge --> ICommerce
CommerceSvc ..|> ICommerce

CommerceSvc -[#E8402A,bold]-> IUserPort
IdentitySvc .[#E8402A].|> IUserPort

CommerceSvc ..> IEvents : publish
Broker ..|> IEvents
Broker ..> NotifQueue : fan-out
Broker ..> AuditQueue : fan-out
NotificationSvc ..> NotifQueue : poll

IdentitySvc ..> SessionStore
CommerceSvc ..> SessionStore
NotificationSvc ..> SessionStore

IdentitySvc --> IdentityDB : SQL
CommerceSvc --> CommerceDB : SQL
NotificationSvc --> NotifDB : SQL

IdentitySvc --> OAuthExt : OAuth 2.0 (ACL)
CommerceSvc --> PaymentExt : Checkout / Refund
PaymentExt --> IWebhook : Signed Webhook
Edge ..|> IWebhook

' Hidden dependencies constrain tier order; they are not runtime interfaces.
PresentationTier -[hidden]down-> ApplicationTier
ApplicationTier -[hidden]down-> IntegrationTier
IntegrationTier -[hidden]down-> DataTier
IAuth -[hidden]right-> ICommerce
ICommerce -[hidden]right-> INotif
@enduml
