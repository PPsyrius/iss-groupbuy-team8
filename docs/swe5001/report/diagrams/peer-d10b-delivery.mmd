%% frame: SWE5001 release prerequisites and always-run cleanup attempts
activityDiagram
    lane "Promotion PR into prod" {
        start S
        action PR["dev into prod: source guard,\nimage validation, infra plan"]
        decision Approval
        action Merge["Merge commit into prod"]
        action Blocked["Merge blocked"]
        end Refused
        end Approved
    }
    lane "swe5001-deploy.yml" {
        start Deploy
        action Images["Build, scan, export images"]
        decision ImagesOk
        action Publish["Publish images and\ncandidate digests"]
        decision PublishOk
        action Up["Create runtime, readiness,\nsmoke suite"]
        decision UpOk
        action Release["Publish SPA and\nrelease digests"]
        merge Cleanup
        action Down["Attempt down (always)\nDestroy + verify"]
        action Evidence["Attempt evidence (always)\nRetain outcomes"]
        end Done
    }
    lane "swe5001-env.yml" {
        start Timer
        action Cron["23:00 SGT cron\nActual run may be late"]
        action Session["Dispatch down on prod\nRecord actual outcome"]
        end SessionEnd
    }
    S --> PR
    PR --> Approval
    Approval --> Merge : [checks green and approved]
    Approval --> Blocked : [otherwise]
    Blocked --> Refused
    Merge --> Approved
    Deploy --> Images
    Images --> ImagesOk
    ImagesOk --> Publish : [succeeds]
    ImagesOk --> Cleanup : [fails]
    Publish --> PublishOk
    PublishOk --> Up : [succeeds]
    PublishOk --> Cleanup : [fails]
    Up --> UpOk
    UpOk --> Release : [succeeds]
    UpOk --> Cleanup : [fails]
    Release --> Cleanup : [either outcome]
    Cleanup --> Down
    Down --> Evidence : [either outcome]
    Evidence --> Done
    Timer --> Cron
    Cron --> Session
    Session --> SessionEnd
%% always() schedules an attempt; neither destruction nor upload success is guaranteed.
