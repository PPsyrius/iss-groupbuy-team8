@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #6B655C
skinparam DefaultFontColor #1B1A18
skinparam NoteBackgroundColor #FFF6E2
skinparam NoteBorderColor #7A5C20
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #FDEFEC
skinparam ClassBorderColor #B02E1B
skinparam InterfaceBackgroundColor #F1F4FD
skinparam InterfaceBorderColor #3E5CD9
skinparam ParticipantBackgroundColor #FDEFEC
skinparam ParticipantBorderColor #B02E1B
skinparam SequenceGroupBackgroundColor #EFE9DF
skinparam SequenceGroupBodyBackgroundColor white
!pragma layout smetana
hide empty members
class GroupDealExpirySweeper {
  -expiry : GroupDealExpiryService
  +sweep(limit : int) : Result
}
class GroupDealExpiryService {
  -deals : PaidGroupDealRepository
  +expireOne(dealId : UUID) : boolean
}
class TeamExpired <<domain event>> {
  +dealId() : UUID
  +at() : Instant
}
class OrderLifecycleSubscriber {
  +onTeamExpired(event : TeamExpired) : void
}
class TeamExpiryRefundSubscriber {
  -refunds : TeamExpiryRefundService
  +onTeamExpired(event : TeamExpired) : void
}
class TeamExpiryRefundService {
  -repository : CheckoutPaymentRepository
  +recordExpiredTeam(dealId : UUID) : void
}
class IntegrationOutboxWriter <<infrastructure>> {
  +onTeamExpired(event : TeamExpired) : void
}
GroupDealExpirySweeper -right-> "1" GroupDealExpiryService : expiry
GroupDealExpiryService ..> TeamExpired : publishes
OrderLifecycleSubscriber .left.> TeamExpired : observes (10)
TeamExpiryRefundSubscriber .left.> TeamExpired : observes (20)
IntegrationOutboxWriter .up.> TeamExpired : observes last
TeamExpiryRefundSubscriber -down-> "1" TeamExpiryRefundService : refunds
@enduml
