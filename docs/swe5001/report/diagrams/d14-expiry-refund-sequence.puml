@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #6B655C
skinparam DefaultFontColor #1B1A18
skinparam NoteBackgroundColor #FFF6E2
skinparam NoteBorderColor #7A5C20
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #FDEFEC
skinparam ClassBorderColor #B02E1B
skinparam InterfaceBackgroundColor #F1F4FD
skinparam InterfaceBorderColor #3E5CD9
skinparam ParticipantBackgroundColor #FDEFEC
skinparam ParticipantBorderColor #B02E1B
skinparam SequenceGroupBackgroundColor #EFE9DF
skinparam SequenceGroupBodyBackgroundColor white
hide footbox
participant "expiry :\nGroupDealExpiryService" as E
participant "events :\nApplicationEventPublisher" as B #F1F4FD
participant "orders :\nOrderLifecycleSubscriber" as O
participant "owed :\nTeamExpiryRefundSubscriber" as P
participant "outbox :\nIntegrationOutboxWriter" as W #FFF6E2
participant "worker :\nRefundService" as R
participant "gateway :\nStripeRefundGateway" as S #EFE9DF
[-> E : expireOne(dealId)
  group One transaction: lock team, recheck deadline
    alt open and overdue
      E -> B : publishEvent(TeamExpired)
      group Spring BEFORE_COMMIT
        B -> O : onTeamExpired
        B -> P : onTeamExpired
        B -> W : onTeamExpired
      end
    else already resolved
      E -->[ : false (no event)
    end
  end
== After commit: independent workers ==
[-> R : processNext()
note over R : Claim in a short transaction.
alt first or safely retryable attempt
  R -> S : createRefund(work)
else known provider refund
  R -> S : retrieveRefund(id)
end
S --> R : provider status
note over R : Persist result in a new transaction.
note over W : Separately, the relay publishes the stored event\nto SNS; SQS delivers it to notification.
@enduml
