%% frame: Notifications design, slice 2: the outbox relay and its transports (commerce-svc)
classDiagram
    class OutboxRelayJob {
        <<scheduled job, Sched>>
        +run(): void
    }
    class LeasedJobRunner {
        <<Sched, Conc>>
        +run(job: String, lease: Duration, work: LeasedJobRunner.LeaseAwareWork): void
    }
    class OutboxRelayService {
        <<application service, Evt>>
        ~BATCH_SIZE: int = 100
        ~MAX_ATTEMPTS: int = 10
        +relayBatch(leaseValid: BooleanSupplier): int
    }
    class OutboxRelayRepository {
        <<interface, repository, Pers>>
        +findDue(limit: int): List~OutboxEvent~
        +recordResults(results: List~OutboxPublishResult~, maxAttempts: int): int
    }
    class OutboxEvent {
        <<record>>
        +id: UUID
        +eventType: String
        +eventVersion: int
        +aggregateId: UUID
        +payloadJson: String
        +traceId: String
        +createdAt: Instant
        +attempts: int
    }
    class OutboxPublishResult {
        <<record>>
        +eventId: UUID
        +published: boolean
        +failureReason: String
        +attempted: boolean
    }
    class OutboxEventTransport {
        <<interface, gateway, Ext>>
        +publish(events: List~OutboxEvent~, leaseValid: BooleanSupplier): List~OutboxPublishResult~
    }
    class BatchingOutboxEventTransport~E~ {
        <<abstract>>
        +publish(events: List~OutboxEvent~, leaseValid: BooleanSupplier): List~OutboxPublishResult~ «final»
        #entry(event: OutboxEvent): E
        #send(events: List~OutboxEvent~, entries: List~E~): List~OutboxPublishResult~
    }
    class SnsOutboxEventTransport {
        <<adapter, Ext, Dist>>
        -client: SnsClient
        -topicArn: String
        #entry(event: OutboxEvent): PublishBatchRequestEntry
        #send(events: List~OutboxEvent~, entries: List~PublishBatchRequestEntry~): List~OutboxPublishResult~
    }
    class SqsOutboxEventTransport {
        <<adapter, Ext>>
        -client: SqsClient
        -queueUrl: String
        #entry(event: OutboxEvent): SendMessageBatchRequestEntry
        #send(events: List~OutboxEvent~, entries: List~SendMessageBatchRequestEntry~): List~OutboxPublishResult~
    }
    class OutboxMessageFactory {
        <<converter>>
        ~body(event: OutboxEvent, json: ObjectMapper): String «static»
        ~attributes(event: OutboxEvent): Map<String, String> «static»
    }
    class IntegrationEventEnvelope~T~ {
        <<record, Dist>>
        +eventId: UUID
        +eventType: String
        +version: int
        +occurredAt: Instant
        +producer: String
        +traceId: String
        +aggregateId: UUID
        +payload: T
    }
%% at LeasedJobRunner 0,0
%% at OutboxEvent 1,0
%% at OutboxRelayRepository 2,0
%% at OutboxPublishResult 3,0
%% at OutboxRelayJob 0,1
%% at OutboxRelayService 1,1
%% at OutboxEventTransport 2,1
%% at SnsOutboxEventTransport 3,1
%% at SqsOutboxEventTransport 1,2
%% at BatchingOutboxEventTransport 2,2
%% at OutboxMessageFactory 3,2
%% at IntegrationEventEnvelope 4,2
    OutboxRelayJob "1" --> "1" LeasedJobRunner : runner
    OutboxRelayJob "1" --> "1" OutboxRelayService : relay
    OutboxRelayService "1" --> "1" OutboxRelayRepository : repository
    OutboxRelayService "1" --> "1" OutboxEventTransport : transport
    OutboxRelayRepository ..> OutboxEvent
    OutboxEventTransport ..> OutboxPublishResult
    OutboxEventTransport <|.. BatchingOutboxEventTransport
    BatchingOutboxEventTransport <|-- SqsOutboxEventTransport
    BatchingOutboxEventTransport <|-- SnsOutboxEventTransport
    BatchingOutboxEventTransport ..> OutboxMessageFactory
    OutboxMessageFactory ..> IntegrationEventEnvelope : «create»
