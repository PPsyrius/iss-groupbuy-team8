%% frame: UC5 B1-B4: the last seat fills the team (design)
sequenceDiagram
    participant Ful as :OrderFulfilmentAdapter
    participant Svc as :PaidGroupDealService
    participant GD as before : GroupDeal
    create participant Ev as :TeamSucceeded
    participant Pub as :ApplicationEventPublisher
    participant OLS as :OrderLifecycleSubscriber
    participant Ord as :OrderRepository
    participant Out as :IntegrationOutboxWriter
    participant Cache as :OpenDealOfferCacheSubscriber

    critical UC4 settlement transaction, REQUIRED, READ COMMITTED, 10 s (team row lock held)
        Note over Ful,GD: B1: UC4 B7 (@fig-a-uc04-ds-admit)
        Ful->>Svc: joinConfirmed(dealId, paid, sharerUserId)
        Svc->>GD: joinPaid(paid, alreadyMember, now)
        Note over GD,Pub: B2: currentSize + 1 = targetSize: SUCCEEDED, successTime := now
        GD-->>Svc: PaidAdmission(deal: after, teamCompleted: true)
        Note over Ful,GD: insertJoinedMember, complete, MemberJoined (UC4)
        opt admission.teamCompleted()
            Svc->>Ev: «create»
            Svc->>Pub: publishEvent(event)
            Pub-->>Svc: held until commit
        end
        Svc-->>Ful: ParticipationResult (applied)
        Note over Ful,GD: UC4 B8 saves the joiner's PENDING order (@fig-a-uc04-ds-fulfil)
        Note over Pub,Out: B3: BEFORE_COMMIT, still in the transaction, in @Order
        Pub->>OLS: onTeamSucceeded(event), @Order(10)
        OLS->>Ord: confirmByDealId(dealId)
        Ord-->>OLS: int confirmed (status = pending guard)
        OLS-->>Pub: return
        Note over Pub,Out: B4: only when blocbuy.events.enabled
        Pub->>Out: onTeamSucceeded(event), lowest precedence
        Note over Ord,Cache: inserts a TeamSucceededV1 row into sys_outbox (@fig-a-uc05-ds-expire-events)
        Out-->>Pub: return
    end
    Note over Ful,Cache: B4: COMMIT, then AFTER_COMMIT, outside the transaction
    Pub->>Cache: onTeamSucceeded(event)
    Note over Ord,Cache: evicts the product's cached open-deal offer
