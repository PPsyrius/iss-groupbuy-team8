%% frame: UC5 design, slice 2: resolving one team, group-buy module (commerce-svc)
classDiagram
    class GroupDealExpiryService {
        <<application service, Conc, Evt>>
        +expireOne(dealId: UUID): boolean
    }
    class OrderFulfilmentAdapter {
        <<adapter, application service>>
    }
    class PaidGroupDealService {
        <<application service, Conc, Evt>>
        +joinConfirmed(dealId: UUID, paid: PaidParticipation, sharerUserId: UUID): ParticipationResult
    }
    class ApplicationEventPublisher {
        <<interface, Evt>>
        +publishEvent(event: Object): void
    }
    class PaidGroupDealRepository {
        <<interface, repository, Pers, Conc>>
        +lockDeal(dealId: UUID): Optional~GroupDeal~
        +currentTime(): Instant
        +expire(before: GroupDeal, after: GroupDeal, now: Instant): void
    }
    class PaidGroupDealRepositoryImpl {
        <<adapter, Pers>>
    }
    class PaidGroupDealMapper {
        <<interface, mapper, Pers, Conc>>
        +lockDeal(dealId: UUID): BizGroupDealDO
        +currentTime(): Instant
        +expireDeal(deal: BizGroupDealDO): int
    }
    class GroupDeal {
        <<aggregate root>>
        -targetSize: int
        -currentSize: int
        -expireTime: Instant
        -successTime: Instant
        -status: DealStatus
        +joinPaid(payment: PaidParticipation, alreadyMember: boolean, now: Instant): PaidAdmission
        +requireJoinWindow(now: Instant): void
        +expire(now: Instant): GroupDeal
    }
    class DealStatus {
        <<enumeration>>
        OPEN
        SUCCEEDED
        FAILED
        EXPIRED
        CANCELED
        +canTransitionTo(target: DealStatus): boolean
    }
    class PaidAdmission {
        <<value object, record>>
        +deal: GroupDeal
        +teamCompleted: boolean
    }
    class TeamSucceeded {
        <<domain event, record>>
        +dealId: UUID
        +productId: UUID
        +size: int
        +at: Instant
    }
    class TeamExpired {
        <<domain event, record>>
        +dealId: UUID
        +productId: UUID
        +at: Instant
    }
%% at OrderFulfilmentAdapter 0,1
%% at TeamSucceeded 1,0
%% at ApplicationEventPublisher 2,0
%% at TeamExpired 3,0
%% at PaidGroupDealService 1,1
%% at GroupDeal 2,1
%% at GroupDealExpiryService 3,1
%% at PaidAdmission 1,2
%% at PaidGroupDealRepository 2,2
%% at DealStatus 3,2
%% at PaidGroupDealRepositoryImpl 2,3
%% at PaidGroupDealMapper 3,3
    OrderFulfilmentAdapter "1" --> "1" PaidGroupDealService
    PaidGroupDealService "1" --> "1" ApplicationEventPublisher
    GroupDealExpiryService "1" --> "1" ApplicationEventPublisher
    PaidGroupDealService "1" --> "1" PaidGroupDealRepository
    GroupDealExpiryService "1" --> "1" PaidGroupDealRepository
    PaidGroupDealService ..> TeamSucceeded : «create»
    GroupDealExpiryService ..> TeamExpired : «create»
    PaidGroupDealService ..> GroupDeal
    GroupDealExpiryService ..> GroupDeal
    PaidGroupDealRepository ..> GroupDeal
    GroupDeal ..> PaidAdmission : «create»
    PaidGroupDealRepositoryImpl ..|> PaidGroupDealRepository
    PaidGroupDealRepositoryImpl "1" --> "1" PaidGroupDealMapper
