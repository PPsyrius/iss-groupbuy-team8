%% frame: UC3 design, slice 1: team price quote, catalog module (commerce-svc)
classDiagram
    class TeamPriceController {
        <<controller, Pres, Sec>>
        +issue(request: QuoteRequest): Result~QuoteResponse~
    }
    class TeamPriceAppService {
        <<interface, application service>>
        +issueQuote(productId: UUID, ownerId: UUID): TeamPriceQuote
    }
    class UserAppService {
        <<interface, Dist>>
        +requireActive(userId: UUID): void
    }
    class ProductRepository {
        <<interface, repository, Pers, Conc>>
        +lockById(id: UUID): Optional~Product~
    }
    class TeamPriceAppServiceImpl {
        <<application service, Conc>>
        -QUOTE_LIFETIME: Duration = 15 min
        +issueQuote(productId: UUID, ownerId: UUID): TeamPriceQuote
    }
    class TeamPriceRepository {
        <<interface, repository, Pers>>
        +findLatestPolicy(productId: UUID): Optional~TeamPricePolicy~
        +currentTime(): Instant
        +insertQuote(quote: TeamPriceQuote): void
    }
    class Product {
        <<aggregate root>>
        -originalPrice: BigDecimal
        -currency: String
        -stock: int
        -status: ProductStatus
        -pricingMode: PricingMode
        -teamTerms: ProductTeamTerms
    }
    class PricingStrategyResolver {
        <<application service>>
        +strategyFor(mode: PricingMode): PricingStrategy
    }
    class TeamPriceQuote {
        <<entity, record>>
        +id: UUID
        +productId: UUID
        +ownerId: UUID
        +policyVersion: int
        +amount: BigDecimal
        +currency: String
        +issuedAt: Instant
        +expiresAt: Instant
    }
    class DualPricingStrategy {
        <<domain service>>
        +quoteTeamPrice(product: Product, policy: TeamPricePolicy, now: Instant): BigDecimal
    }
    class PricingStrategy {
        <<interface, domain service>>
        +quoteTeamPrice(product: Product, policy: TeamPricePolicy, now: Instant): BigDecimal
    }
    class TeamPricePolicy {
        <<entity, record>>
        +productId: UUID
        +amount: BigDecimal
        +currency: String
        +validFrom: Instant
        +validUntil: Instant
        +version: int
        +requireQuotable(product: Product, now: Instant): void
    }
%% at TeamPriceController 0,0
%% at TeamPriceAppService 1,0
%% at UserAppService 2,0
%% at ProductRepository 0,1
%% at TeamPriceAppServiceImpl 1,1
%% at TeamPriceRepository 2,1
%% at Product 0,2
%% at PricingStrategyResolver 1,2
%% at TeamPriceQuote 2,2
%% at DualPricingStrategy 0,3
%% at PricingStrategy 1,3
%% at TeamPricePolicy 2,3
    TeamPriceController "1" --> "1" TeamPriceAppService
    TeamPriceAppServiceImpl ..|> TeamPriceAppService
    TeamPriceAppServiceImpl "1" --> "1" UserAppService
    TeamPriceAppServiceImpl "1" --> "1" ProductRepository
    TeamPriceAppServiceImpl "1" --> "1" TeamPriceRepository
    TeamPriceAppServiceImpl "1" --> "1" PricingStrategyResolver
    TeamPriceAppServiceImpl ..> TeamPriceQuote : «create»
    ProductRepository ..> Product
    TeamPriceRepository ..> TeamPriceQuote
    PricingStrategyResolver "1" --> "1..*" PricingStrategy
    DualPricingStrategy ..|> PricingStrategy
    PricingStrategy ..> TeamPricePolicy
