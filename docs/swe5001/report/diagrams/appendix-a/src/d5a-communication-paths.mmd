%% frame: BlocBuy SWE5001 communication paths
deploymentDiagram
    device Browser["Buyer's browser"]
    node Cdn["Amazon CloudFront"] <<global edge>>
    node Stripe["Stripe"] <<external system>>
    node Google["Google Sign-In"] <<external system>>
    node S3["Amazon S3"] <<bucket>> : SPA files
    zone "VPC 10.50.0.0/16" {
        zone "Public" {
            node Alb["Application Load Balancer"]
            node Nat["fck-nat"]
        }
        zone "Private" {
            environment Fg["ECS Fargate, Arm64"] {
                artifact Id["identity-svc"]
                artifact Co["commerce-svc"]
                artifact Nt["notification-svc"]
            }
        }
        zone "Data" {
            node Cache["ElastiCache Valkey"] : TLS 6379
            node Rds["RDS PostgreSQL"] : TLS 5432
        }
    }
    zone "SNS and SQS" as Msg {
        node Sns["domain-events"] <<SNS topic>> :::messaging
        node QNt["notification"] <<SQS queue>> :::messaging : and its DLQ
        node QAu["audit"] <<SQS queue>> :::messaging : and its DLQ
    }
    Browser -- Cdn : HTTPS 443
    Cdn --> S3 : HTTPS (OAC)
    Stripe --> Cdn : HTTPS 443
    Cdn --> Alb : HTTP 80, origin secret
    Alb --> Fg : HTTP 8589
    Co --> Id : HTTP 8589
    Id --> Cache
    Co --> Cache
    Nt --> Cache
    Id --> Rds
    Co --> Rds
    Nt --> Rds
    Id --> Nat : HTTPS 443
    Co --> Nat : HTTPS 443
    Nt --> Nat : HTTPS 443
    Nat --> Stripe : HTTPS 443
    Nat --> Google : HTTPS 443
    Nat --> Msg
    Sns --> QNt
    Sns --> QAu
