%% frame: UC8 B3 and A6: my orders and one of my orders (design, commerce-svc)
sequenceDiagram
    actor Buyer
    participant Ctl as :OrderController
    participant App as :OrderAppServiceImpl
    participant Repo as :OrderRepository
    participant O as :Order

    Buyer->>Ctl: myOrders(page, size, response)
    Note over Buyer,Repo: B3: GET /api/v1/orders/me; StpUtil.checkLogin(); buyer = session login id; Cache-Control: no-store
    break no session (A1)
        Ctl-->>Buyer: UNAUTHENTICATED (COMMON_401_001)
    end
    Ctl->>App: pageMyOrders(query, buyer)
    critical tx REQUIRED, read-only, READ COMMITTED, no timeout
        App->>Repo: pageByUserId(query, buyer)
        Repo-->>App: PageResult(Order), rows then count
        loop each order
            App->>App: toView(order)
        end
    end
    App-->>Ctl: PageResult(OrderSummaryView)
    Ctl-->>Buyer: Result(PageResult(OrderSummaryResponse))
    Note over Buyer,Ctl: A6: GET /api/v1/orders/{orderId}, from the payment receipt
    Buyer->>Ctl: myOrder(orderId, response)
    Ctl->>App: findMine(orderId, buyer)
    critical tx REQUIRED, read-only, READ COMMITTED, no timeout
        App->>Repo: findById(orderId)
        Repo-->>App: Optional(Order)
        App->>O: userId()
        O-->>App: UUID owner
        alt missing, or owner is not the buyer (A6)
            App-->>Ctl: Optional.empty()
        else
            App->>App: toView(order)
            App-->>Ctl: Optional(OrderSummaryView)
        end
    end
    alt empty
        Ctl-->>Buyer: ORDER_NOT_FOUND (ORDER_404_001)
    else
        Ctl-->>Buyer: Result(OrderSummaryResponse)
    end
