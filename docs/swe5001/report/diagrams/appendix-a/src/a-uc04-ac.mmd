    JoinTeamUI "1" -- "1" JoinTeamControl
    JoinTeamControl "1" -- "1" PaymentGateway
    JoinTeamControl "1" --> "1" Account
    JoinTeamControl "1" --> "1" Product
    JoinTeamControl "1" --> "1" Payment
    JoinTeamControl "1" --> "*" Order
    JoinTeamControl "1" --> "1" Team
    JoinTeamControl "1" --> "*" PurchaseIntent
    Payment "1" *-- "0..1" Refund
    Order "*" -- "1" Team
    Team "1" *-- "1..*" Membership
    PurchaseIntent "*" -- "1" Team
