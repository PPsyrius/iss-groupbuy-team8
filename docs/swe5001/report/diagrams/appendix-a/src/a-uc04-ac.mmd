%% frame: UC4 Join an existing team by paying (analysis)
classDiagram
    class JoinTeamUI {
        <<boundary>>
        +join(team, invitation)
        +showJoined(teamStatus)
        +showRejected(reason)
        +showRefundPending()
    }
    class Account {
        <<entity>>
        -status: AccountStatus
        +isActive()
    }
    class PaymentGateway {
        <<boundary>>
        +requestPayment(intent)
        +paid(paymentRef)
    }
    class Product {
        <<entity>>
        -title: Text
        -stock: Count
        -status: ProductStatus
        +isPurchasable()
        +takeOneUnit()
    }
    class JoinTeamControl {
        <<control>>
        +requestJoin(buyer, team, invitation)
        +paymentConfirmed(paymentRef)
    }
    class Payment {
        <<entity>>
        -amount: Money
        -status: PaymentStatus
        -outcome: PaymentOutcome
        +recordOutcome(outcome)
        +requireRefund(reason)
    }
    class Refund {
        <<entity>>
        -amount: Money
        -reason: Text
        -status: RefundStatus
    }
    class Order {
        <<entity>>
        -amount: Money
        -status: OrderStatus
        +confirm()
    }
    class Team {
        <<entity>>
        -price: Money
        -targetSize: Count
        -currentSize: Count
        -deadline: Date-time
        -status: TeamStatus
        +resolveSharer(invitation, buyer)
        +checkAdmission(buyer)
        +admit(buyer, payment)
    }
    class PurchaseIntent {
        <<entity>>
        -price: Money
        -payableUntil: Date-time
        -fulfilled: Boolean
        +isPayable()
        +markFulfilled(payment)
    }
    class Membership {
        <<entity>>
        -role: MemberRole
        -joinTime: Date-time
    }
    class Invitation {
        <<entity>>
        -reference: Identifier
        +attributes(team, buyer)
    }
