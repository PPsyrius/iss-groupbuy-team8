%% frame: UC7 Share an invitation and attribute referrals (analysis)
classDiagram
    class ShareInviteUI {
        <<boundary>>
        +shareTeam(team)
        +showLink(invitation)
        +showRefused(reason)
    }
    class InviteLandingUI {
        <<boundary>>
        +openLink(team, reference)
        +showBanner(nickname)
        +showGenericBanner()
    }
    class JoinTeamUI {
        <<boundary>>
        +join(team, invitation)
    }
    class ShareInvitationControl {
        <<control>>
        +requestInvitation(member, team)
        +resolveInvitation(reference)
    }
    class PurchaseIntent {
        <<entity>>
        -price: Money
        -payableUntil: Date-time
    }
    class JoinTeamControl {
        <<control>>
        +requestJoin(buyer, team, invitation)
        +paymentConfirmed(payment)
    }
    class Account {
        <<entity>>
        -nickname: Text
        -status: AccountStatus
        +publicNickname()
    }
    class Invitation {
        <<entity>>
        -reference: Text
        +lookUp(reference)
        +attributes(team, buyer)
        +sharer()
    }
    class Team {
        <<entity>>
        -targetSize: Count
        -currentSize: Count
        -deadline: Date-time
        -status: TeamStatus
        +hasMember(member)
        +isOpen()
        +invitationOf(member)
        +resolveSharer(invitation, buyer)
        +admit(buyer, payment)
    }
    class ReferralCreditControl {
        <<control>>
        +memberJoined(membership)
    }
    class Membership {
        <<entity>>
        -role: MemberRole
        -joinTime: Date-time
        +sharer()
    }
    class ShareCredit {
        <<entity>>
        -creditTime: Date-time
    }
