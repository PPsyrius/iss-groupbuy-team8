%% frame: Pay upfront design, slice 2: settlement in the payment module (commerce-svc)
classDiagram
    class ApplicationEventPublisher {
        <<interface, Evt>>
        +publishEvent(event: Object): void
    }
    class StripeCheckoutService {
        <<application service, Ext, Conc>>
        -tx: TransactionTemplate
        -settle(session: CheckoutGateway.Session, eventId: String, type: String, operator: String, id: UUID): void
        -matches(payment: CheckoutPayment, session: CheckoutGateway.Session): boolean
        -fulfilOrCompensate(payment: CheckoutPayment, eventId: String): String
    }
    class PaymentSucceeded {
        <<domain event, record>>
        +paymentId: UUID
        +quote: CheckoutQuote
        +confirmedAt: Instant
    }
    class CheckoutPayment {
        <<aggregate root, record>>
        +quote: CheckoutQuote
        +status: CheckoutPayment.Status
        +bind(session: String, url: String, intent: String): CheckoutPayment
        +succeed(): CheckoutPayment
        +cancelUnpaid(): CheckoutPayment
        +failTerminalUnpaid(): CheckoutPayment
    }
    class CheckoutPaymentRepository {
        <<interface, repository, Pers, Conc>>
        +claimEvent(eventId: String, type: String): boolean
        +finishEvent(eventId: String, paymentId: UUID, result: String): void
        +outcome(paymentId: UUID): String
        +requireRefund(payment: CheckoutPayment, reason: String, eventId: String): void
        +recordOutcome(paymentId: UUID, dealId: UUID, orderId: UUID, outcome: String): void
    }
    class PaymentBusinessPort {
        <<interface, Dist, Conc>>
        +lockForSettlement(quote: CheckoutQuote): void
        +fulfil(event: PaymentSucceeded): PaymentBusinessPort.Outcome
    }
    class OrderFulfilmentAdapter {
        <<adapter, application service, Dist>>
    }
    class Outcome["PaymentBusinessPort.Outcome"] {
        <<value object, record>>
        +dealId: UUID
        +orderId: UUID
        +rejection: String
        +accepted(): boolean
    }
%% at ApplicationEventPublisher 0,0
%% at PaymentSucceeded 1,0
%% at OrderFulfilmentAdapter 2,0
%% at StripeCheckoutService 1,1
%% at PaymentBusinessPort 2,1
%% at CheckoutPayment 0,2
%% at CheckoutPaymentRepository 1,2
%% at Outcome 2,2
    StripeCheckoutService "1" --> "1" ApplicationEventPublisher
    StripeCheckoutService ..> PaymentSucceeded : «create»
    StripeCheckoutService "1" --> "1" CheckoutPaymentRepository
    StripeCheckoutService "1" --> "1" PaymentBusinessPort
    CheckoutPaymentRepository ..> CheckoutPayment
    PaymentBusinessPort ..> PaymentSucceeded
    OrderFulfilmentAdapter ..|> PaymentBusinessPort
    PaymentBusinessPort ..> Outcome
