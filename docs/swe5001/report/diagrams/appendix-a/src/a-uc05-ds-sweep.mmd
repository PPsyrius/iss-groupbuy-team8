%% frame: UC5 B5-B7: the expiry sweep under its lease (design)
sequenceDiagram
    actor Sch as Scheduler
    participant Job as :TeamExpirySweepJob
    participant Run as :LeasedJobRunner
    participant Lease as :SchedulerLeaseRepository
    participant Work as work : LeaseAwareWork
    participant Sw as :GroupDealExpirySweeper
    participant Deals as :PaidGroupDealRepository
    participant Exp as :GroupDealExpiryService

    Note over Sch,Job: B5: fixed delay PT1M after the previous run ends
    Sch->>Job: run()
    Job->>Run: run("team-expiry-sweep", lease: PT2M, work: this::sweepOnce)
    Run->>Lease: tryAcquire(job, owner, lease)
    Lease-->>Run: boolean acquired
    alt not acquired: another instance holds the lease (A1)
        Run-->>Job: skipped
    else acquired
        par renewal every lease / 3 on a virtual thread
            Run->>Lease: renew(job, owner, lease)
            Lease-->>Run: false sets leaseValid := false (A3)
        and the work
            Run->>Work: run(leaseValid)
            Work->>Sw: sweep(batchSize: 100, leaseValid)
            Note over Sw,Deals: B6
            Sw->>Deals: currentTime()
            Deals-->>Sw: Instant now
            Sw->>Deals: dueForExpiry(now, limit)
            Deals-->>Sw: List of UUID, oldest deadline first
            loop each dealId, while leaseValid.getAsBoolean()
                Note over Sw,Exp: B7-B10: one transaction per team, none around the batch (@fig-a-uc05-ds-expire)
                Sw->>Exp: expireOne(dealId)
                alt returned true
                    Exp-->>Sw: true, expired + 1
                else returned false: already resolved (A2)
                    Exp-->>Sw: false, alreadyResolved + 1
                else RuntimeException: the team's transaction rolled back (E1)
                    Exp-->>Sw: exception, failed + 1
                    Sw->>Deals: deferExpiryRetry(dealId, RETRY_DELAY)
                end
            end
            Sw-->>Work: Result(due, expired, alreadyResolved, failed)
            Work-->>Run: return (counters recorded)
        end
        Run->>Lease: release(job, owner)
        Run-->>Job: completed or failed
    end
