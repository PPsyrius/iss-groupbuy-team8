%% frame: PurchaseIntent lifecycle (UC3, UC4 and Pay upfront)
stateDiagram-v2
    state "Issued" as Issued
    state "Lapsed" as Lapsed
    state "Fulfilled" as Fulfilled
    state "Expired" as Expired
    Issued : no payment, expiredAt null
    Lapsed : a deadline passed, not swept
    Fulfilled : fulfilledPaymentId set
    Expired : expiredAt set
    [*] --> Issued : issue [now < quoteValidUntil] / save(intent)
    Issued --> Fulfilled : markFulfilled [accepted] / fulfilBy
    Fulfilled --> Fulfilled : markFulfilled [same payment] / none
    Issued --> Lapsed : when(now ≥ a deadline)
    Lapsed --> Lapsed : paid / refund, BUSINESS_EXPIRED
    Lapsed --> Expired : expireOne [unpaid] / markExpired
    Lapsed --> [*] : expireOne [paid] / excludePaidFromExpiry
    Expired --> Expired : paid / refund, INTENT_EXPIRED
    Fulfilled --> [*]
    Expired --> [*]
