%% frame: UC7 B8–B9: record the sharer, then credit after commit (design, commerce-svc)
sequenceDiagram
    participant F as :OrderFulfilmentAdapter
    participant S as :PaidGroupDealService
    participant R as :PaidGroupDealRepository
    participant P as :ApplicationEventPublisher
    participant Sub as :ShareCreditSubscriber
    create participant SC as ShareCredit
    participant CR as :ShareCreditRepository

    critical tx REQUIRED (settlement), READ COMMITTED, 10 s
        Note over F,R: B8: inside UC4's settlement transaction
        F->>S: joinConfirmed(dealId, paid, sharerUserId)
        alt admission refused, or the payment replayed (A8)
            S-->>F: refused or frozen ParticipationResult; no MemberJoined
        else admitted
            S->>R: insertJoinedMember(before, after, paid, sharer, now)
            S->>P: publishEvent(MemberJoined)
            S-->>F: ParticipationResult applied
        end
    end
    Note over P,CR: B9: COMMIT, then AFTER_COMMIT on the same thread
    P->>Sub: onMemberJoined(event)
    opt event.attributed()
        critical tx REQUIRES_NEW, READ COMMITTED, 10 s
            Sub->>SC: «create» of(event)
            Sub->>CR: recordIfAbsent(credit)
            CR-->>Sub: true, or false for a duplicate (A9)
        end
        Note over Sub,CR: E2: any failure is caught and logged; ADR 0003 reconciles
    end
    Sub-->>P: void, never throws
