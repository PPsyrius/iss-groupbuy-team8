%% frame: GroupDeal (team) lifecycle, DealStatus
stateDiagram-v2
    state "OPEN" as OPEN
    state "SUCCEEDED" as SUCCEEDED
    state "EXPIRED" as EXPIRED
    state "FAILED" as FAILED
    state "CANCELED" as CANCELED
    SUCCEEDED : entry / orders confirmed by OrderLifecycleSubscriber (same transaction)
    EXPIRED : entry / orders cancelled by OrderLifecycleSubscriber, refunds owed by TeamExpiryRefundSubscriber (UC6), same transaction
    [*] --> OPEN : «create» paidStartConfirmed / currentSize := 1 (UC3)
    OPEN --> OPEN : paidJoinConfirmed [admissible, currentSize + 1 < targetSize] / currentSize += 1 (UC4)
    OPEN --> OPEN : paidJoinConfirmed [not admissible] / refund owed (UC4 A6, UC5 E3)
    OPEN --> SUCCEEDED : paidJoinConfirmed [admissible, currentSize + 1 = targetSize] / successTime := now; publish TeamSucceeded (UC5 B1-B2)
    OPEN --> EXPIRED : tick [now >= expireTime] / publish TeamExpired (UC5 B7)
    SUCCEEDED --> SUCCEEDED : paidJoinConfirmed / refund owed (UC4 A6)
    EXPIRED --> EXPIRED : paidJoinConfirmed / refund owed (UC4 A6)
