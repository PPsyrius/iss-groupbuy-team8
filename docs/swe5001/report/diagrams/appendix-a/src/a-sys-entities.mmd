%% frame: BlocBuy system-level analysis model: all entities
classDiagram
    class SignInState {
        <<entity>>
        -value: Text
        -expireTime: Date‑time
    }
    class Role {
        <<entity>>
        -code: Text
    }
    class Session {
        <<entity>>
        -roleSnapshot: Text
        -expireTime: Date‑time
    }
    class Notification {
        <<entity>>
        -type: NotificationType
        -createTime: Date‑time
    }
    class ConsumptionRecord {
        <<entity>>
        -consumer: Text
        -consumedAt: Date‑time
    }
    class OAuthBinding {
        <<entity>>
        -provider: Text
        -subject: Text
    }
    class Account {
        <<entity>>
        -nickname: Text
        -status: AccountStatus
    }
    class ReviewCase {
        <<entity>>
        -reason: Text
        -status: ReviewStatus
    }
    class EventRecord {
        <<entity>>
        -eventType: Text
        -status: DeliveryStatus
    }
    class Invitation {
        <<entity>>
        -reference: Text
    }
    class Membership {
        <<entity>>
        -role: MemberRole
        -joinTime: Date‑time
    }
    class Order {
        <<entity>>
        -amount: Money
        -status: OrderStatus
    }
    class Payment {
        <<entity>>
        -amount: Money
        -status: PaymentStatus
        -outcome: PaymentOutcome
    }
    class ShareCredit {
        <<entity>>
        -creditTime: Date‑time
    }
    class Team {
        <<entity>>
        -price: Money
        -targetSize: Count
        -deadline: Date‑time
        -status: TeamStatus
    }
    class PurchaseIntent {
        <<entity>>
        -operation: PurchaseOperation
        -price: Money
        -payableUntil: Date‑time
    }
    class Refund {
        <<entity>>
        -amount: Money
        -reason: Text
        -status: RefundStatus
    }
    class TeamTermsChange {
        <<entity>>
        -previousTerms: Text
        -currentTerms: Text
        -changeTime: Date‑time
    }
    class Product {
        <<entity>>
        -title: Text
        -stock: Count
        -status: ProductStatus
    }
    class PriceQuote {
        <<entity>>
        -price: Money
        -expiresAt: Date‑time
    }
    class RefundAttempt {
        <<entity>>
        -attemptTime: Date‑time
        -result: Text
    }
    class TeamPricePolicy {
        <<entity>>
        -price: Money
        -validFrom: Date‑time
        -validUntil: Date‑time
    }
