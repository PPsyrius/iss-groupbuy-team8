%% frame: Notifications B3-B6 with A3, A4, A5, E1: the SQS consumer (design, notification-svc)
sequenceDiagram
    participant C as :SqsNotificationEventConsumer
    participant Q as notification queue (queue)
    participant D as :IntegrationEventDecoder
    participant H as :NotificationEventHandler
    participant DLQ as notification-dlq (queue)

    Note over C,Q: B3: one poller thread, at most 4 workers (concurrency)
    loop while running
        C->>C: pollOnce()
        C->>Q: ReceiveMessage(free workers, wait 20 s, visibility 60 s)
        Q-->>C: List<Message>
        loop each message, on a worker thread
            C->>C: process(message)
            C->>D: decode(body)
            alt malformed (A5)
                D-->>C: MalformedIntegrationEventException
                Note over C,Q: A5: not deleted; visible again after 60 s
                Q-)DLQ: moved on the fifth receive (maxReceiveCount 5)
            else type or version not supported (A4)
                D-->>C: Decoded, supported() false
                C->>Q: DeleteMessage(receiptHandle)
            else supported
                D-->>C: Decoded with event
                Note over C,H: B4-B5: @fig-a-ntf-ds-record
                C->>H: handle(consumer, event)
                alt committed: APPLIED, or DUPLICATE (A3)
                    H-->>C: ConsumeOutcome
                    Note over C,Q: B6
                    C->>Q: DeleteMessage(receiptHandle)
                else exception, rolled back (E1)
                    H-->>C: RuntimeException
                    Note over C,Q: E1: not deleted; delivered again after 60 s
                end
            end
        end
    end
