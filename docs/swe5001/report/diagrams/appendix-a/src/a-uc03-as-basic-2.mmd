%% frame: UC3 basic flow, part 2: open the team, after payment (analysis)
sequenceDiagram
    participant PU as PayUpfrontControl (control)
    participant Ctl as StartTeamControl (control)
    participant Intent as PurchaseIntent (entity)
    participant Acc as Account (entity)
    participant Prod as Product (entity)
    create participant Team as Team (entity)
    create participant Ord as Order (entity)
    create participant Mem as Membership (entity)
    participant UI as StartTeamUI (boundary)

    Note over PU,Intent: B8: Pay upfront B5–B7 verified the payment (@sec-a-pay-upfront)
    PU->>Ctl: B8: paymentConfirmed(payment)
    Ctl->>Intent: B9: isPayable()
    Intent-->>Ctl: payable
    Ctl->>Acc: B9: isActive()
    Acc-->>Ctl: active
    Ctl->>Prod: B9: isPurchasable()
    Prod-->>Ctl: purchasable
    Ctl->>Intent: B10: acceptsPayment(amount)
    Intent-->>Ctl: accepted
    Ctl->>Team: B10: «create» (intent terms, leader)
    Team->>Mem: B10: «create» (leader)
    Ctl->>Ord: B11: «create» (buyer, team price)
    Ctl->>Intent: B11: fulfilBy(payment)
    Ctl->>Prod: B11: takeOneUnit()
    Ctl-->>PU: B12: outcome (fulfilled), recorded by Pay upfront
    Ctl->>UI: B13: showStarted(teamStatus)
