%% frame: BlocBuy logical deployment, no products
deploymentDiagram
    device Client["Buyer's device"] {
        environment Browser["Web browser"] {
            artifact Spa["SPA bundle"]
        }
    }
    node Edge["Content delivery edge"]
    node Store["Static file store"]
    node Idp["Identity provider"] <<external system>>
    node Pay["Payment provider"] <<external system>>
    node Lb["Load balancer"]
    rectangle "Application tier" as AppTier {
        node IdN["Application server"] {
            environment IdJ["Java 21 runtime"] {
                artifact IdA["identity-svc.jar"]
            }
        }
        node CoN["Application server"] {
            environment CoJ["Java 21 runtime"] {
                artifact CoA["commerce-svc.jar"]
            }
        }
        node NtN["Application server"] {
            environment NtJ["Java 21 runtime"] {
                artifact NtA["notification-svc.jar"]
            }
        }
    }
    rectangle "Data and messaging tier" {
        node Cache["Cache and session store"] : key-value, shared
        node Db["Database server"] : one database per service
        node Broker["Message broker"] : topic, queues, DLQs
    }
    Client -- Edge : HTTPS
    Edge -- Store : HTTPS
    Client -- Idp : HTTPS
    Edge -- Lb : HTTP
    Lb -- AppTier : HTTP
    CoN -- IdN : HTTP
    IdN -- Idp : HTTPS
    CoN -- Pay : HTTPS
    Pay -- Edge : HTTPS
    AppTier -- Cache : TLS
    AppTier -- Db : JDBC, TLS
    CoN -- Broker : HTTPS
    NtN -- Broker : HTTPS
