%% frame: UC1 design, slice 1: catalog read path (commerce-svc)
classDiagram
    class ProductController {
        <<controller, Dist, Sec>>
        +pageListings(page: Integer, size: Integer, category: String, keyword: String, ai: boolean): Result~PageResult~
        +getListing(id: UUID): Result~ProductDetailResponse~
    }
    class ProductAppService {
        <<interface, Dist>>
        +pageListings(page: Integer, size: Integer, category: String): PageResult~ListingView~
        +search(query: ListingQuery): PageResult~ListingView~
        +getListingDetail(productId: UUID): ListingDetailView
    }
    class GroupDealQueryService {
        <<interface, Dist>>
        +findBestOpenDealsByProductIds(productIds: Collection~UUID~): Map~UUID,OpenDealOffer~
    }
    class ListingQuery {
        <<record>>
        +keyword: String
        +category: String
        +page: PageQuery
        +aiRerank: boolean
        +of(keyword: String, category: String, page: Integer, size: Integer, aiRerank: boolean): ListingQuery «static»
        +keywordTokens(): List~String~
    }
    class ProductAppServiceImpl {
        <<application service, Pers>>
        -rerank(query: ListingQuery, products: List~Product~): List~Product~
        -toPageResult(products: PageResult~Product~, query: PageQuery): PageResult~ListingView~
    }
    class ListingSearchReranker {
        <<interface, gateway, Ext>>
        +rerank(keyword: String, candidates: List~Candidate~): List~UUID~
    }
    class ProductRepository {
        <<interface, repository, Pers>>
        +pageOnSale(page: PageQuery, category: String): PageResult~Product~
        +searchOnSale(page: PageQuery, category: String, keywordTokens: List~String~): PageResult~Product~
        +findById(id: UUID): Optional~Product~
    }
    class Product {
        <<aggregate root, Pers>>
        -status: ProductStatus
        -pricingMode: PricingMode
        +isOnSale(): boolean
    }
    class TypeSafeJevListingSearchReranker {
        <<adapter, Ext>>
        +rerank(keyword: String, candidates: List~Candidate~): List~UUID~
    }
    class ProductRepositoryImpl {
        <<adapter, Pers>>
        +searchOnSale(page: PageQuery, category: String, keywordTokens: List~String~): PageResult~Product~
        -toLikePattern(token: String): String «static»
    }
    class BizProductMapper {
        <<interface, mapper, Pers>>
        +selectVisibleSearchPage(category: String, patterns: List~String~, limit: int, offset: long): List~BizProductDO~
        +countVisibleSearch(category: String, patterns: List~String~): long
    }
