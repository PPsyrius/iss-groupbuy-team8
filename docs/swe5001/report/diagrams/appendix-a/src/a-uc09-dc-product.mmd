classDiagram
    class ProductRepository {
        <<interface, repository, Pers>>
        +lockById(id: UUID): Optional~Product~
        +updateListing(product: Product, expectedVersion: int, actorId: UUID): void
    }
    class ListingDetails {
        <<value object, record>>
        +title: String
        +subtitle: String
        +description: String
        +coverImage: String
        +images: List~String~
        +category: String
        +originalPrice: BigDecimal
        +currency: String
        +stock: int
    }
    class ProductTeamTerms {
        <<value object, record>>
        +MIN_TARGET_SIZE: int = 2 «static»
        +MIN_LIFETIME_SECONDS: int = 2400 «static»
        +MAX_LIFETIME_SECONDS: int = 86400 «static»
        +targetSize: Integer
        +lifetimeSeconds: Integer
    }
    class Product {
        <<aggregate root>>
        -id: UUID
        -productNo: String
        -originalPrice: BigDecimal
        -currency: String
        -stock: int
        -soldCount: int
        -version: int
        +draft(id: UUID, productNo: String, details: ListingDetails): Product «static»
        +revise(details: ListingDetails): Product
        +publish(): Product
        +delist(): Product
        +requireDeletable(): void
        +configureTeamTerms(targetSize: int, lifetimeSeconds: int): Product
        +requireVersion(expected: int): void
        -transition(next: ProductStatus): Product
    }
    class TeamTermsSpecification {
        <<domain service>>
        ~violations(targetSize: int, lifetimeSeconds: int): Map<String, Object> «static»
    }
    class ProductRepositoryImpl {
        <<adapter, Pers>>
        +lockById(id: UUID): Optional~Product~
        +updateListing(product: Product, expectedVersion: int, actorId: UUID): void
        -requireChanged(count: int): void «static»
    }
    class ProductStatus {
        <<enumeration>>
        DRAFT
        ON_SALE
        OFF_SALE
        ~publish(): ProductStatus
        ~delist(): ProductStatus
        ~deletionError(): CatalogErrorCode
        ~requireCommercialEdit(current: Product, next: ListingDetails): void
    }
    class ProductStatusOFFSALE["ProductStatus.OFF_SALE"] {
        ~publish(): ProductStatus
    }
    class BizProductMapper {
        <<interface, mapper, Pers, Conc>>
        +selectActiveByIdForUpdate(id: UUID): BizProductDO
        +updateListing(row: BizProductDO, expectedVersion: int, actorId: UUID): int
    }
    class ProductStatusDRAFT["ProductStatus.DRAFT"] {
        ~publish(): ProductStatus
        ~deletionError(): CatalogErrorCode
        ~requireCommercialEdit(current: Product, next: ListingDetails): void
    }
    class ProductStatusONSALE["ProductStatus.ON_SALE"] {
        ~delist(): ProductStatus
    }
