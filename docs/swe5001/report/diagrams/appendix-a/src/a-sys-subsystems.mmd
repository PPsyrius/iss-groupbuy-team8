%% frame: BlocBuy subsystems: three services by COLA layer (backend ADR 0008)
classDiagram
    class IdAsm["identity-svc assembly"] {
        <<component>>
        IdentityServiceApplication
    }
    class IdAdp["identity-svc adapter"] {
        <<component>>
        AuthController, LoginSessionPublisher
        internal: InternalUserController
    }
    class IdApp["identity-svc application"] {
        <<component>>
        UserAppServiceImpl, OAuthLoginAppServiceImpl, LoginAuthorizationService
    }
    class IdDom["identity-svc domain"] {
        <<component>>
        aggregates: User, OAuthIdentity
        ports: UserRepository, OAuthIdentityGateway, LoginSnapshotGateway
    }
    class IdInf["identity-svc infrastructure"] {
        <<component>>
        UserRepositoryImpl, SysUserMapper, GoogleOAuthGateway, RedisLoginSnapshotGateway, StpInterfaceImpl
    }
    class CoAsm["commerce-svc assembly"] {
        <<component>>
        CommerceServiceApplication
        RemoteUserAppService
        LeasedJobRunner and five jobs
    }
    class CoAdp["commerce-svc adapter"] {
        <<component>>
        ProductController, GroupDealController, StripeCheckoutController, StripeWebhookController, OrderController, AdminListingController
    }
    class CoApp["commerce-svc application"] {
        <<component>>
        port: UserAppService
        StripeCheckoutService, OrderFulfilmentAdapter, PaidGroupDealService, OutboxRelayService, event subscribers
    }
    class CoDom["commerce-svc domain"] {
        <<component>>
        aggregates: GroupDeal, PurchaseIntent, Order, CheckoutPayment, Product
        ports: PaymentBusinessPort, PaymentIntentPort, OutboxEventTransport, repositories
    }
    class CoInf["commerce-svc infrastructure"] {
        <<component>>
        repository implementations and mappers, StripeCheckoutGateway, IntegrationOutboxWriter, SnsOutboxEventTransport, SessionStpInterface
    }
    class NoAsm["notification-svc assembly"] {
        <<component>>
        NotificationServiceApplication
    }
    class NoAdp["notification-svc adapter"] {
        <<component>>
        NotificationController
    }
    class NoApp["notification-svc application"] {
        <<component>>
        NotificationEventAppService, NotificationAppService
    }
    class NoDom["notification-svc domain"] {
        <<component>>
        aggregate: Notification
        ports: NotificationEventHandler, NotificationRepository, ConsumedMessageRepository
    }
    class NoInf["notification-svc infrastructure"] {
        <<component>>
        SqsNotificationEventConsumer, IntegrationEventDecoder, NotificationRepositoryImpl, SessionStpInterface
    }
