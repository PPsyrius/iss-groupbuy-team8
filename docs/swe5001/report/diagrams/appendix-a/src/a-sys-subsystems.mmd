    IdAsm ..> IdAdp
    IdAdp ..> IdApp
    IdApp ..> IdDom
    IdInf ..|> IdDom
    CoAsm ..> CoAdp
    CoAdp ..> CoApp
    CoApp ..> CoDom
    CoInf ..|> CoDom
