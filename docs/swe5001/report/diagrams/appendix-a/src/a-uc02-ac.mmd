%% frame: UC2 Sign in with Google (analysis)
classDiagram
    class SignInUI {
        <<boundary>>
        +signIn(returnTo)
        +showSignedIn(returnTo)
        +showFailure(reason)
        +signOut()
    }
    class SignInWithGoogleControl {
        <<control>>
        +startSignIn()
        +completeSignIn(code, state, binding)
        +signOut(session)
        +checkAccess(request, role)
    }
    class IdentityProvider {
        <<boundary>>
        +authorize(state)
        +returned(code, state, binding)
        +verify(code)
    }
    class SignInState {
        <<entity>>
        -value: Text
        -binding: Text
        -expireTime: Date-time
        +consume(binding)
    }
    class MemberAreaUI {
        <<boundary>>
        +requestMemberAction(action)
        +offerSignIn(returnTo)
        +showAccessDenied()
    }
    class OAuthBinding {
        <<entity>>
        -provider: Text
        -subject: Text
        -lastSignIn: Date-time
        +findBySubject(provider, subject)
        +touchSignIn(profile)
    }
    class Session {
        <<entity>>
        -roleSnapshot: Text
        -permissionSnapshot: Text
        -expireTime: Date-time
        +hasRole(role)
        +end()
    }
    class Account {
        <<entity>>
        -email: Text
        -nickname: Text
        -status: AccountStatus
        -lastSignIn: Date-time
        +isEmailTaken(email)
        +ensureActive()
        +touchSignIn()
    }
    class Role {
        <<entity>>
        -code: Text
        -permissions: Text
        +grantTo(account)
        +grantedTo(account)
    }
%% at SignInUI 0,0
%% at MemberAreaUI 1,0
%% at IdentityProvider 2,0
%% at Session 0,1
%% at SignInWithGoogleControl 1,1
%% at SignInState 2,1
%% at Account 0,2
%% at OAuthBinding 1,2
%% at Role 0,3
    SignInUI "1" -- "1" SignInWithGoogleControl
    SignInWithGoogleControl "1" -- "1" IdentityProvider
    MemberAreaUI "*" -- "1" SignInWithGoogleControl
    SignInWithGoogleControl "1" --> "*" SignInState
    SignInWithGoogleControl "1" --> "0..1" OAuthBinding
    SignInWithGoogleControl "1" --> "*" Session
    Session "*" -- "1" Account : for
    Account "1" -- "*" OAuthBinding : signs in with
    Account "*" -- "1..*" Role : holds
