%% frame: UC8 View my orders and my teams (analysis)
classDiagram
    class MyBlocsUI {
        <<boundary>>
        +openMyBlocs(page)
        +showTeams(rows, total)
        +showOrders(rows, total)
        +filterTeams(chip)
        +openOrder(order)
        +showNotFound()
    }
    class ViewMyTeamsControl {
        <<control>>
        +listMyTeams(buyer, page)
    }
    class ViewMyOrdersControl {
        <<control>>
        +listMyOrders(buyer, page)
        +findMyOrder(buyer, order)
    }
    class Account {
        <<entity>>
        -nickname: Text
        -status: AccountStatus
        +memberships(page)
        +orders(page)
    }
    class Product {
        <<entity>>
        -title: Text
        -coverImage: Text
        -status: ProductStatus
        +displayFieldsOf(products)
    }
    class Team {
        <<entity>>
        -price: Money
        -targetSize: Count
        -currentSize: Count
        -deadline: Date-time
        -status: TeamStatus
        +summary()
    }
    class Membership {
        <<entity>>
        -role: MemberRole
        -joinTime: Date-time
        +describe()
    }
    class Order {
        <<entity>>
        -amount: Money
        -productTitle: Text
        -productImage: Text
        -paidTime: Date-time
        -status: OrderStatus
        +summary()
        +belongsTo(buyer)
    }
