%% frame: Order lifecycle, OrderStatus
stateDiagram-v2
    state "PENDING" as PENDING
    state "CONFIRMED" as CONFIRMED
    state "CANCELLED" as CANCELLED
    [*] --> PENDING : fulfil accepted / Order.create (UC3, UC4 B8)
    PENDING --> CONFIRMED : TeamSucceeded [pending] / confirmByDealId (UC5 B3)
    PENDING --> CANCELLED : TeamExpired [pending] / cancelByDealId; cancelTime := at (UC5 B8)
    CONFIRMED --> [*]
    CANCELLED --> [*]
