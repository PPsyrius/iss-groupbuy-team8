%% frame: PurchaseIntent sweep: a lapsed intent is expired (design, commerce-svc)
sequenceDiagram
    actor Sch as Scheduler
    participant Job as :PurchaseIntentExpiryJob
    participant Run as :LeasedJobRunner
    participant Sw as :PurchaseIntentExpirySweeper
    participant Exp as :PurchaseIntentExpiryService
    participant Teams as :GroupDealSettlementSupport
    participant Repo as :PurchaseIntentRepository
    participant Pay as :PaymentIntentExpirySupport

    Note over Sch,Run: every minute; lease, renewal and leaseValid as in @fig-a-uc05-ds-sweep
    Sch->>Job: run()
    Job->>Run: run(job, lease, work: this::sweepOnce)
    Run->>Sw: sweep(batchSize, leaseValid)
    Sw->>Repo: dueForExpiry(now, limit), now from currentTime()
    Repo-->>Sw: List of UUID
    loop each intent id, while leaseValid.getAsBoolean()
        Sw->>Exp: expireOne(id)
        critical REQUIRED, READ COMMITTED, 10 s
            Exp->>Repo: findById(id)
            Exp->>Teams: lockTeam(dealId): lock 1 (no row yet for a START)
            Exp->>Repo: tryLockForExpiry(id): lock 2, SKIP LOCKED
            alt held by a settlement, or no deadline passed yet
                Exp-->>Sw: SKIPPED
            else lapsed: after := before.expireAt(currentTime())
                Exp->>Pay: hasSucceededIntent(id)
                alt paid
                    Exp-->>Sw: PAID
                else unpaid
                    Exp->>Repo: markExpired(before, after)
                    Exp-->>Sw: EXPIRED
                end
            end
        end
        alt PAID
            Sw->>Repo: excludePaidFromExpiry(id)
        else SKIPPED or an exception
            Sw->>Repo: deferExpiryRetry(id, RETRY_DELAY)
        end
    end
    Sw-->>Run: PurchaseIntentExpirySweeper.Result
