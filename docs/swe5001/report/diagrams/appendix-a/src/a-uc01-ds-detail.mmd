%% frame: UC1 B6 to B9 with A5 and E3: view one product, cache-aside team lookup (design)
sequenceDiagram
    actor Visitor
    participant Ctl as :ProductController
    participant App as :ProductAppServiceImpl
    participant Repo as :ProductRepository
    participant P as :Product
    participant Q as :GroupDealQueryServiceImpl
    participant C as :OpenDealOfferCache
    participant R as :GroupDealRepository

    Note over Visitor,Ctl: B6
    Visitor->>Ctl: getListing(id)
