%% frame: UC8 design, slice 2: my teams (commerce-svc, groupbuy and catalog modules)
classDiagram
    class GroupDealController {
        <<controller, Dist, Sec>>
        +myTeams(page: Integer, size: Integer, response: HttpServletResponse): Result<PageResult<GroupDealController.MyTeamResponse>>
    }
    class GroupDealAppService {
        <<interface>>
        +pageMyTeams(page: PageQuery, userId: UUID): PageResult~MyTeamView~
    }
    class GroupDealAppServiceImpl {
        <<application service, Conc>>
        +pageMyTeams(page: PageQuery, userId: UUID): PageResult~MyTeamView~
        -toView(membership: TeamMembership, listing: ListingDisplayGateway.ListingDisplay): MyTeamView
    }
    class GroupDealRepository {
        <<interface, repository, Pers>>
        +pageMembershipsByUserId(query: PageQuery, userId: UUID): PageResult~TeamMembership~
    }
    class TeamMembership {
        <<value object, record>>
        +productId: UUID
        +status: DealStatus
        +role: MemberRole
        +joinTime: Instant
    }
    class GroupDealRepositoryImpl {
        <<adapter, Pers>>
        +pageMembershipsByUserId(query: PageQuery, userId: UUID): PageResult~TeamMembership~
    }
    class BizGroupDealMapper {
        <<interface, mapper, Pers>>
        +selectMembershipPageByUserId(userId: UUID, limit: int, offset: long): List~TeamMembershipDO~
        +countMembershipsByUserId(userId: UUID): long
    }
    class ListingDisplayGateway {
        <<interface, gateway, Dist>>
        +findByProductIds(productIds: Collection~UUID~): Map<UUID, ListingDisplayGateway.ListingDisplay>
    }
    class ListingDisplay["ListingDisplayGateway.ListingDisplay"] {
        <<value object, record>>
        +productId: UUID
        +title: String
        +coverImage: String
    }
    class GroupbuyListingDisplayAdapter {
        <<adapter, Dist>>
        +findByProductIds(productIds: Collection~UUID~): Map<UUID, ListingDisplayGateway.ListingDisplay>
        -toDisplay(product: ProductDisplay): ListingDisplayGateway.ListingDisplay
    }
    class ProductRepository {
        <<interface, repository, Pers>>
        +findDisplaysByIds(ids: Collection~UUID~): List~ProductDisplay~
    }
    class ProductDisplay {
        <<value object, record>>
        +productId: UUID
        +title: String
        +coverImage: String
    }
