%% frame: UC5 B8-B10: the subscribers of TeamExpired at commit (design)
sequenceDiagram
    participant Pub as :ApplicationEventPublisher
    participant OLS as :OrderLifecycleSubscriber
    participant Ord as :OrderRepository
    participant Ref as :TeamExpiryRefundSubscriber
    participant Out as :IntegrationOutboxWriter
    participant CS as :OpenDealOfferCacheSubscriber

    critical expireOne transaction (continued), BEFORE_COMMIT phase, in @Order
        Note over Pub,Ord: B8
        Pub->>OLS: onTeamExpired(event), @Order(10)
        OLS->>Ord: cancelByDealId(dealId, canceledAt: event.at)
        Ord-->>OLS: int cancelled (status = pending guard)
        OLS-->>Pub: return
        Note over Pub,Ref: B9: «extend» UC6 (@sec-a-uc06)
        Pub->>Ref: onTeamExpired(event), @Order(20)
        Note over Ref,Out: UC6: recordExpiredTeam(dealId) records one refund obligation per paid member
        Ref-->>Pub: return
        Note over Pub,Out: B10: only when blocbuy.events.enabled
        Pub->>Out: onTeamExpired(event), lowest precedence
        Note over Out: writes the TeamExpiredV1 outbox row for the active members, @fig-a-ntf-ds-produce
        Out-->>Pub: return
    end
    Note over Pub,CS: COMMIT, then AFTER_COMMIT, outside the transaction
    Pub->>CS: onTeamExpired(event)
    Note over Out,CS: evicts the product's cached open-deal offer
