%% frame: UC4 B6 to B8: fulfilment, order side (design)
sequenceDiagram
    participant Svc as :StripeCheckoutService
    participant OFA as :OrderFulfilmentAdapter
    participant Set as :GroupDealSettlementSupport
    participant Intents as :PurchaseIntentRepository
    participant Users as :UserAppService
    participant Cat as :CatalogPurchaseSupport
    participant Groups as :PaidGroupDealService
    create participant Ord as :Order
    participant Orders as :OrderRepository

    critical settlement transaction (opened in Pay upfront), READ COMMITTED, 10 s
        Svc->>OFA: B6: lockForSettlement(quote)
        OFA->>Set: lockTeam(dealId): lock 1
        OFA->>Intents: lockById(intentId): lock 2
        Note over Svc,Users: payment side, @sec-a-pay-upfront: lock 4 (payment), succeed, publish PaymentSucceeded
        break quote.expiredAt(now): paid too late (A5)
            Note over Svc,Users: Outcome(null, null, "BUSINESS_EXPIRED"); fulfil is never called
        end
        Svc->>OFA: fulfil(event)
        Note over OFA,Intents: re-takes lock 1 and lock 2 (already held)
        break intent.fulfilled() (A8)
            OFA-->>Svc: replayed, or INTENT_ALREADY_FULFILLED
        end
        OFA->>Users: requireActive(userId)
        break identity-svc unreachable (E1)
            Users-->>OFA: IdentityUnavailableException: rollback
        end
        OFA->>Cat: requirePurchasable(productId)
        break intent lapsed, buyer inactive or product unavailable (A5)
            OFA-->>Svc: Outcome: INTENT_EXPIRED, BUYER_INACTIVE or PRODUCT_UNAVAILABLE
        end
        Note over OFA,Groups: B7: @fig-a-uc04-ds-admit
        OFA->>Groups: joinConfirmed(dealId, paid, sharerUserId)
        Groups-->>OFA: ParticipationResult
        break not applied (A6, A7)
            OFA-->>Svc: Outcome: GROUP_REJECTED
        end
        Note over OFA,Orders: B8: the first business writes
        OFA->>Ord: «create» create(terms, confirmedAt)
        OFA->>Orders: save(order): PENDING
        OFA->>Set: linkOrder(dealId, paymentId, orderId)
        OFA->>Intents: markFulfilled(intent, paymentId)
        OFA->>Cat: consumeOneUnit(productId)
        break false: the last unit has gone (E1)
            OFA-->>Svc: IllegalStateException: rollback
        end
        OFA-->>Svc: Outcome(dealId, orderId, null)
    end
