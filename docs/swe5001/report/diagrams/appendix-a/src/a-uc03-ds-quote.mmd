%% frame: UC3 B1 to B4: issue a team price quote (design)
sequenceDiagram
    actor Buyer
    participant Ctl as :TeamPriceController
    participant App as :TeamPriceAppServiceImpl
    participant Prods as :ProductRepository
    participant Users as :UserAppService
    participant Prices as :TeamPriceRepository
    participant Res as :PricingStrategyResolver
    participant Str as :PricingStrategy
    participant Pol as :TeamPricePolicy
    create participant Quote as :TeamPriceQuote

    Note over Buyer,Ctl: B1
    Buyer->>Ctl: issue(request {productId})
    Ctl->>App: issueQuote(productId, ownerId)
    critical quote transaction, REQUIRED, READ COMMITTED, 10 s
        Note over App,Prods: B2: lock 6, the product row, which UC9 takes to change a price
        App->>Prods: lockById(productId)
        Prods-->>App: Optional(Product)
        App->>Users: requireActive(ownerId)
        break identity-svc unreachable (E2)
            Users-->>App: IdentityUnavailableException
            App-->>Ctl: exception: transaction rolled back
            Ctl-->>Buyer: HTTP 500, no quote
        end
        Note over App,Pol: B3
        App->>Prices: findLatestPolicy(productId)
        Prices-->>App: Optional(TeamPricePolicy)
        App->>Prices: currentTime()
        Prices-->>App: now
        App->>Res: strategyFor(mode)
        Res-->>App: PricingStrategy
        App->>Str: quoteTeamPrice(product, policy, now)
        Str->>Pol: requireQuotable(product, now)
        break TEAM_PRICE_UNAVAILABLE: no policy in force, not on sale, or not below the solo price (A2)
            Pol-->>Str: BizException
            Str-->>App: BizException
            App-->>Ctl: BizException, rolled back
            Ctl-->>Buyer: HTTP 409, no quote
        end
        Str-->>App: amount
        App->>Quote: «create» (id, productId, ownerId, version, amount, currency, now, expiry)
        App->>Prices: insertQuote(quote)
    end
    App-->>Ctl: TeamPriceQuote
    Ctl-->>Buyer: Result(QuoteResponse)
    Note over Buyer,Ctl: B4: the quote sheet counts down to expiresAt
