%% frame: UC8 design, slice 1: my orders (commerce-svc, order module)
classDiagram
    class OrderController {
        <<controller, Dist, Sec>>
        +myOrders(page: Integer, size: Integer, response: HttpServletResponse): Result<​PageResult<​OrderSummaryResponse>>
        +myOrder(orderId: UUID, response: HttpServletResponse): Result<OrderSummaryResponse>
    }
    class OrderAppService {
        <<interface>>
        +pageMyOrders(page: PageQuery, userId: UUID): PageResult<​OrderSummaryView>
        +findMine(orderId: UUID, userId: UUID): Optional<​OrderSummaryView>
    }
    class OrderAppServiceImpl {
        <<application service>>
        +pageMyOrders(page: PageQuery, userId: UUID): PageResult<​OrderSummaryView>
        +findMine(orderId: UUID, userId: UUID): Optional<​OrderSummaryView>
        -toView(order: Order): OrderSummaryView «static»
    }
    class OrderSummaryView {
        <<record>>
        +productTitle: String
        +productImage: String
        +totalAmount: BigDecimal
        +status: String
    }
    class OrderRepository {
        <<interface, repository, Pers>>
        +pageByUserId(query: PageQuery, userId: UUID): PageResult~Order~
        +findById(id: UUID): Optional~Order~
    }
    class Order {
        <<aggregate root>>
        -status: OrderStatus
        +userId(): UUID
    }
