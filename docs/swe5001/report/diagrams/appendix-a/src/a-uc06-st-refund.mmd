%% frame: refund obligation (biz_refund.status)
stateDiagram-v2
    state "pending" as pending
    state "processing" as processing
    state "succeeded" as succeeded
    state "failed" as failed
    state "review" as review
    state worker <<choice>>
    state recon <<choice>>
    [*] --> pending : «create» / insert 'pending'
    pending --> worker : processNext() [due]
    processing --> worker : processNext() [due]
    worker --> processing : [provider pending or retryable]
    worker --> failed : [provider failed or canceled]
    worker --> review : [unsafe]
    worker --> succeeded : [provider succeeded]
    review --> recon : reconcile(paymentId, providerId)
    failed --> recon : reconcile(paymentId, providerId)
    recon --> processing : [provider pending]
    recon --> failed : [provider failed or canceled]
    recon --> review : [mismatch, refusal or provider error]
    recon --> succeeded : [provider succeeded]
    succeeded --> [*]
