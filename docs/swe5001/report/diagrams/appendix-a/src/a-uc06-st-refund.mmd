%% frame: refund obligation (biz_refund.status)
stateDiagram-v2
    state "pending" as pending
    state "processing" as processing
    state "succeeded" as succeeded
    state "failed" as failed
    state "review" as review
    state answer <<choice>>
    [*] --> pending : TeamExpired / requireRefundsForExpiredTeam
    pending --> answer : processNext() [due]
    processing --> answer : processNext() [due]
    review --> answer : reconcile()
    failed --> answer : reconcile()
    answer --> succeeded : [succeeded] / finish
    answer --> processing : [pending or retryable] / finish
    answer --> failed : [failed or canceled] / finish
    answer --> review : [unsafe] / finish
    succeeded --> [*]
