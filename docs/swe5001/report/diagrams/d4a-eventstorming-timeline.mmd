flowchart LR
  %% EventStorming Timeline for UC3-UC6 (Team Formation, Settlement, Lifecycle & Refund)
  subgraph Act1["UC3 & UC4: Quote & Pay-First Settlement (Order · Payment · GroupBuy)"]
    C1["Command: CreatePurchaseIntent\n(START / JOIN)"] --> A1["Aggregate: PurchaseIntent\n& CheckoutPayment"]
    A1 --> E1["Event: PurchaseIntentIssued\n& CheckoutSessionCreated"]
    E1 --> EXT1[["External: Stripe\nHosted Checkout"]]
    EXT1 --> E2["Pivotal Event:\nPaymentSucceeded"]
    E2 --> P1["Policy: PaymentBusinessPort.fulfil\n(1 ACID Txn: Lock Team→Intent→Payment)"]
    P1 --> E3["Events: TeamStarted / MemberJoined\n+ OrderPlaced + StockConsumed"]
    P1 --> E4["Event: FulfilmentRejected\n→ RefundObligationRecorded"]
  end

  subgraph Act2["UC5: Team Resolution (GroupBuy → Order · Payment · Outbox)"]
    E3 -->|"last seat filled"| E5["Pivotal Event:\nTeamSucceeded"]
    T1(("Time: 60s Leased\nTeamExpirySweepJob")) --> E6["Pivotal Event:\nTeamExpired"]
    E5 --> P2["Policy (BEFORE_COMMIT):\nConfirm Orders + Write Outbox V1"]
    E6 --> P3["Policy (BEFORE_COMMIT):\nCancel Orders + Record Refunds + Write Outbox V1"]
  end

  subgraph Act3["UC6 & Async Fan-out: Refund Execution & Notification"]
    P3 --> T2(("Time: 30s Leased\nRefundWorkerJob"))
    T2 --> EXT2[["External: Stripe\nRefunds API"]]
    EXT2 --> E7["Events: RefundSucceeded\n/ RetryDue / SentToReview"]
    P2 & P3 --> BUS["Outbox Relay → SNS → SQS\nNotification & Audit Queues"]
  end
