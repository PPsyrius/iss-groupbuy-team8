%% frame: CI: applicable checks, scan failures and review gate
activityDiagram
    lane "GitHub: dev" {
        start S
        fork F
        join J
        decision Approval
        action Merge["Squash merge"]
        action Blocked["Job fails or approval absent:\nmerge blocked"]
        end Failed
        end E
    }
    lane "ci-backend.yml" {
        action BQ["Verify, contract, Sonar"]
        action Dock["Monolith build + smoke\nTrivy image scan"]
        decision Mono
    }
    lane "security.yml" {
        action Sec["Secret, dependency\nand config checks"]
    }
    lane "swe5001-service-images.yml" {
        decision ImagePaths
        action Img["ARM64 image build\nTrivy image scan"]
        decision ImageScan
        merge ImageResult
    }
    lane "infra-swe5001.yml" {
        decision InfraPaths
        action Infra["Offline stack checks\nAWS foundation plan"]
        merge InfraResult
    }
    S --> F
    F --> BQ
    F --> Sec
    F --> ImagePaths
    F --> InfraPaths
    BQ --> Dock
    Dock --> Mono
    Mono --> J : [scan passes]
    Mono --> Blocked : [scan fails]
    Sec --> J
    ImagePaths --> Img : [triggered]
    ImagePaths --> ImageResult : [not triggered]
    Img --> ImageScan
    ImageScan --> ImageResult : [scan passes]
    ImageScan --> Blocked : [scan fails]
    ImageResult --> J
    InfraPaths --> Infra : [triggered]
    InfraPaths --> InfraResult : [not triggered]
    Infra --> InfraResult
    InfraResult --> J
    J --> Approval
    Approval --> Merge : [checks green and approved]
    Approval --> Blocked : [otherwise]
    Blocked --> Failed
    Merge --> E
