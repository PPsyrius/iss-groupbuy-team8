{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoExpensiveServices",
      "Effect": "Deny",
      "Action": [
        "sagemaker:*",
        "bedrock:*",
        "redshift:*",
        "eks:*",
        "elasticmapreduce:*",
        "kendra:*",
        "opensearch:*",
        "es:*",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:ModifyReservedInstances",
        "savingsplans:*",
        "route53domains:RegisterDomain",
        "aws-marketplace:*",
        "aoss:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SmallInstancesOnly",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotLike": {
          "ec2:InstanceType": [
            "t3.*",
            "t3a.*",
            "t4g.*"
          ]
        }
      }
    },
    {
      "Sid": "SmallRdsOnly",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:RestoreDBInstanceToPointInTime",
        "rds:CreateDBInstanceReadReplica"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "rds:DatabaseClass": [
            "db.t3.*",
            "db.t4g.*"
          ]
        }
      }
    }
  ]
}
