{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm --version)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm gen:api)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm fmt)",
      "Bash(pnpm fmt:check)",
      "Bash(pnpm test)",
      "Bash(pnpm knip)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm e2e)",
      "Bash(pnpm hooks:install)",
      "Bash(pnpm exec lefthook install)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec oxlint --type-aware)",
      "Bash(pnpm exec oxfmt --check)",
      "Bash(pnpm dlx @tanstack/intent@0.4.0 list --json)",
      "Bash(pnpm dlx @tanstack/intent@0.4.0 install)",
      "Bash(pnpm dlx @tanstack/intent@0.4.0 install --map)",
      "Bash(corepack enable)",
      "Bash(corepack pnpm --version)",
      "Bash(corepack pnpm install --frozen-lockfile)",
      "Bash(corepack pnpm check)",
      "Bash(mise install)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "deny": [
      "Read(./frontend/e2e/.auth/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(pnpm publish)",
      "Bash(pnpm publish *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/agile-evidence-capture/scripts/commit-evidence-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(frontend/**)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-fix.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Write(frontend/**)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-fix.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-typecheck.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-bootstrap.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
