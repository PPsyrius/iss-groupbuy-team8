{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "unicorn",
    "vitest",
    "promise"
  ],
  "jsPlugins": ["@tanstack/eslint-plugin-query", "@tanstack/eslint-plugin-router"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "options": { "typeAware": true },
  "rules": {
    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/no-rest-destructuring": "error",
    "@tanstack/query/stable-query-client": "error",
    "@tanstack/router/create-route-property-order": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/hooks": "error",
    "react/purity": "error",
    "react/immutability": "error",
    "react/refs": "error",
    "react/globals": "error",
    "react/exhaustive-effect-dependencies": "error",
    "import/no-cycle": "error",
    "unicorn/filename-case": "off",
    "react/react-in-jsx-scope": "off",
    // React Compiler memoizes object and function props; TanStack Router's `params` and `search`
    // are object props by API and React Aria's `onPress` takes a handler (T2-01, plan §12 note
    // 37). The array variant stays on.
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }
    ]
  },
  "ignorePatterns": [
    "src/api/generated/**",
    "src/routeTree.gen.ts",
    "dist/**",
    "playwright-report/**",
    "test-results/**",
    "public/mockServiceWorker.js"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": { "react-perf/jsx-no-new-function-as-prop": "off" }
    }
  ]
}
