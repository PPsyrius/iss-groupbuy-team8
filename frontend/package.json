{
  "name": "@blocbuy/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "pnpm gen:api",
    "gen:api": "node scripts/verify-generator-params.mjs && node scripts/clean-api-output.mjs && openapi-ts && node scripts/ts-nocheck-generated.mjs",
    "dev": "pnpm gen:api && vite",
    "build": "pnpm gen:api && node scripts/verify-csp-styles.mjs && vite build",
    "preview": "vite preview",
    "stack:dev": "docker compose -f ../fullstack-localhost/compose.yaml stop frontend && docker compose -f ../fullstack-localhost/compose.yaml up --build -d frontend-dev && pnpm gen:api && vite --mode stack --port 5173 --strictPort",
    "stack:prod": "docker compose -f ../fullstack-localhost/compose.yaml stop frontend-dev && docker compose -f ../fullstack-localhost/compose.yaml up --build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "hooks:install": "lefthook install",
    "check": "pnpm gen:api && node scripts/verify-csp-styles.mjs && pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm knip",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@hey-api/openapi-ts": "0.0.0-next-20260824173136",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "21.0.4",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "msw": "3.0.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "intent": {
    "skills": [
      "@tanstack/*"
    ],
    "exclude": [
      "@tanstack/router-core#router-core/ssr",
      "@tanstack/devtools#*",
      "@tanstack/devtools-event-client#*"
    ]
  },
  "msw": {
    "workerDirectory": [
      "dev"
    ]
  }
}
