{
  "name": "@blocbuy/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "pnpm gen:api",
    "gen:api": "openapi-ts && node scripts/ts-nocheck-generated.mjs",
    "dev": "vite",
    "build": "pnpm gen:api && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "hooks:install": "lefthook install",
    "check": "pnpm gen:api && pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm knip",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@hey-api/openapi-ts": "0.0.0-next-20260824173136",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.38",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "20.14.5",
    "knip": "6.35.1",
    "lefthook": "2.1.14",
    "msw": "2.15.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "intent": {
    "skills": [
      "@tanstack/*"
    ],
    "exclude": [
      "@tanstack/router-core#router-core/ssr",
      "@tanstack/devtools#*",
      "@tanstack/devtools-event-client#*"
    ]
  },
  "msw": {
    "workerDirectory": [
      "dev"
    ]
  }
}
