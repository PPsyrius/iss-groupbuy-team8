# Copy to /etc/blocbuy/backend.env on the EC2 host, replace every placeholder, then:
#   sudo chown root:root /etc/blocbuy/backend.env
#   sudo chmod 600 /etc/blocbuy/backend.env
#
# BACKEND_IMAGE does not belong here. The deployment script supplies an immutable ECR digest to
# Docker Compose without exposing application secrets to GitHub Actions.

DB_URL=jdbc:postgresql://127.0.0.1:5432/Blocbuy?currentSchema=domain
DB_USERNAME=replace-with-existing-database-user
DB_PASSWORD=replace-with-existing-database-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-existing-redis-password

# Enables expiry AND sandbox refund attempts; count overdue teams and due refunds first.
BLOCBUY_SCHEDULING_ENABLED=false

# Sandbox Checkout is disabled by default in every profile. Enable only after the release checks.
BLOCBUY_STRIPE_CHECKOUT_ENABLED=false
BLOCBUY_PAYMENT_CHECKOUT_SUCCESS_URL=
BLOCBUY_PAYMENT_CHECKOUT_CANCEL_URL=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Jev semantic re-ranking for GET /api/v1/products?keyword=...&ai=true.
TYPESAFE_ENABLED=false
TYPESAFE_API_KEY=

# Google OAuth2 login; must exactly match the OAuth client's authorized redirect URI.
# Single /api: the prefix comes from the controller mappings, no servlet context-path.
GOOGLE_CLIENT_ID=292561274302-h39ekhsmfu9m3a2sukev37npa4d2jde6.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<in /etc/blocbuy/backend.env of EC2>
GOOGLE_REDIRECT_URI=https://d1b3np88z657cp.cloudfront.net/api/v1/auth/oauth2/google/callback
